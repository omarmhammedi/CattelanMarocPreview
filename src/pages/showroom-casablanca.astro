---
import { imageAttributes } from '../lib/images';
import EditorialSection from '../components/EditorialSection.astro';
import ShowroomMap from '../components/ShowroomMap.astro';
import SiteActions from '../components/SiteActions.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { PortableText } from 'emdash/ui';
import { actions, generalWhatsappMessage, whatsappHref } from '../lib/actions';
import { getPage, getSite } from '../lib/content';

const [page, site] = await Promise.all([Astro.props.preloaded || getPage('showroom'), getSite()]);
if (!page) return new Response('Page introuvable', { status: 404 });
const sections = page.sections?.filter((section: any) => !section.key?.startsWith('faq_') && section.key !== 'contact_note') || [];
const contactNotes = page.sections?.filter((section: any) => section.key === 'contact_note') || [];
const questionHeading = (section: any) => String(section.displayHeading || '').trim() || String(section.heading || '').trim();
const questions = page.sections?.filter((section: any) => section.key?.startsWith('faq_') && (
  questionHeading(section) || String(section.text || '').trim() || section.image || (section.ctaLabel && section.ctaHref)
)) || [];
---
<PageLayout title={page.seoTitle || page.title} description={page.description} site={site} image={page.image} entry={page.entry}>
  <section class="page-intro page-gutter">
    {page.eyebrow && <p class="kick">{page.eyebrow}</p>}
    <h1 {...page.entry?.edit?.title}>{page.title}</h1>
    {page.intro && <p class="page-lead" {...page.entry?.edit?.intro}>{page.intro}</p>}
    {site.whatsappUrl && <a class="text-link intro-link" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">{site.labels.contact} · WhatsApp<span aria-hidden="true">↗</span></a>}
  </section>
  <section class="showroom-information page-gutter">
    <div class="showroom-editorial">
      {page.image && <figure class="page-full-figure"><div class="page-image"><img {...imageAttributes(page.image, '(max-width: 760px) 100vw, 60vw', 1600)} alt={page.image.alt || ''} style={page.image.width && page.image.height && page.image.height > page.image.width ? 'object-position: center top;' : undefined} /></div></figure>}
      {page.body?.length > 0 && <div class="page-prose"><PortableText value={page.body} /></div>}
      {sections.map((section: any) => <EditorialSection section={section} />)}
    </div>
    <aside class="showroom-contact" id="showroom-contact" data-page-reveal>
      <p class="kick">Informations pratiques</p><h2>{site.city}</h2>
      <dl>
        {site.address && <div><dt>Adresse</dt><dd>{site.address}</dd></div>}
        {site.hours && <div><dt>Horaires</dt><dd>{site.hours}</dd></div>}
        {site.phone && <div><dt>Téléphone</dt><dd><a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a></dd></div>}
        {site.publicEmail && <div><dt>E-mail</dt><dd><a class="public-email" href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a></dd></div>}
      </dl>
      {contactNotes.map((section: any) => <EditorialSection section={section} />)}
      <ShowroomMap embedUrl={site.mapEmbedUrl} mapUrl={site.mapUrl} name={site.name} address={site.address} />
      {site.whatsappUrl && <a class="text-link" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">{site.labels.contact} · WhatsApp<span aria-hidden="true">↗</span></a>}
    </aside>
  </section>
  {questions.length > 0 && <section class="page-faq page-gutter">
    <div class="section-heading"><h2>Questions fréquentes</h2></div>
    <div>{questions.map((question: any) => questionHeading(question) ? <details data-page-reveal><summary>{questionHeading(question)}<span aria-hidden="true">+</span></summary><EditorialSection section={question} showHeading={false} /></details> : <EditorialSection section={question} showHeading={false} />)}</div>
  </section>}
  <section class="page-cta page-gutter showroom-appointment" id="rendez-vous" aria-labelledby="rendez-vous-heading" data-page-reveal>
    <h2 id="rendez-vous-heading">{actions.appointment.label}</h2>
    <p>Visite libre ou sur rendez-vous.</p>
    <SiteActions order={['advisor', 'catalogue']} advisorHref={whatsappHref(site.whatsappUrl, generalWhatsappMessage)} />
  </section>
</PageLayout>
