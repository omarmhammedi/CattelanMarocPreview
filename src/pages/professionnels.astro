---
import ServicePage from '../components/ServicePage.astro';
import RequestForm from '../components/RequestForm.astro';
import { professionalWhatsappMessage } from '../lib/actions';
import { getPage, getSite } from '../lib/content';

const [page, site] = await Promise.all([Astro.props.preloaded || getPage('professionnels'), getSite()]);
if (!page) return new Response('Page introuvable', { status: 404 });
---
<ServicePage page={page} site={site} order={['appointment', 'advisor', 'catalogue']} whatsappMessage={professionalWhatsappMessage}>
  <Fragment slot="form">
    <h2>Demande professionnelle</h2>
    <p>Présentez votre projet ; un conseiller vous recontacte.</p>
    <RequestForm id="pro-request" kind="pro" site={site} />
  </Fragment>
</ServicePage>
