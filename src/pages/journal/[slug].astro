---
import PageLayout from '../../layouts/PageLayout.astro';
import { PortableText } from 'emdash/ui';
import { getPost, getSite } from '../../lib/content';

const [post, site] = await Promise.all([Astro.props.preloaded || getPost(Astro.params.slug || ''), getSite()]);
if (!post) return new Response('Article introuvable', { status: 404 });
const publishedDate = post.publishedAt ? new Date(post.publishedAt) : null;
const hasDate = publishedDate && !Number.isNaN(publishedDate.getTime());
---
<PageLayout title={post.seoTitle || post.title} description={post.description || post.excerpt} site={site} image={post.image} entry={post.entry}>
  <article>
    <header class="page-intro page-gutter article-intro">
      <a class="kick breadcrumb" href="/journal/">← {site.labels.journal}</a>
      <p class="article-category">{post.category}</p>
      <h1 {...post.entry?.edit?.title}>{post.title}</h1>
      <p class="page-lead" {...post.entry?.edit?.excerpt}>{post.excerpt}</p>
      {(post.author || post.readingTime) && <p class="article-byline">{[post.author, post.readingTime].filter(Boolean).join(' · ')}</p>}
      {hasDate && <time class="article-date" datetime={publishedDate!.toISOString()}>{publishedDate!.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</time>}
    </header>
    {post.image && <figure class="page-gutter page-full-figure article-figure" data-page-reveal>
      <div class="page-image"><img src={post.image.src} alt={post.image.alt || ''} width={post.image.width} height={post.image.height} fetchpriority="high" /></div>
      {post.imageCaption && <figcaption>{post.imageCaption}</figcaption>}
    </figure>}
    <div class="page-gutter article-reading"><div class="page-prose"><PortableText value={post.body} /></div></div>
    {post.sources?.length > 0 && <aside class="article-sources page-gutter">
      <details><summary>Pour aller plus loin</summary><ul>{post.sources.map((source: any) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} <span aria-hidden="true">↗</span></a></li>)}</ul></details>
    </aside>}
    {(post.cta?.text || (post.cta?.label && post.cta?.href)) && <section class="page-cta page-gutter" data-page-reveal>
      {post.cta.text && <p class="cta-copy">{post.cta.text}</p>}
      {post.cta.label && post.cta.href && <a class="btn" href={post.cta.href}>{post.cta.label}<span aria-hidden="true">↗</span></a>}
    </section>}
    <nav class="article-back page-gutter" aria-label="Retour au Journal"><a class="text-link" href="/journal/">{site.labels.journal}<span aria-hidden="true">↗</span></a></nav>
  </article>
</PageLayout>
