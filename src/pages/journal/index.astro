---
import PageLayout from '../../layouts/PageLayout.astro';
import { PortableText } from 'emdash/ui';
import { getPage, getPosts, getSite } from '../../lib/content';

const [page, posts, site] = await Promise.all([Astro.props.preloaded || getPage('journal'), getPosts(), getSite()]);
if (!page) return new Response('Page introuvable', { status: 404 });
---
<PageLayout title={page.seoTitle || page.title} description={page.description} site={site} image={page.image} entry={page.entry}>
  <section class="page-intro page-gutter">
    {page.eyebrow && <p class="kick">{page.eyebrow}</p>}
    <h1 {...page.entry?.edit?.title}>{page.title}</h1>
    <p class="page-lead" {...page.entry?.edit?.intro}>{page.intro}</p>
  </section>
  <section class="journal-grid page-gutter" aria-label="Articles du Journal">
    {posts.map((post: any, index: number) => <article class:list={['journal-card', { 'journal-card-featured': index === 0 }]} data-page-reveal>
      <a href={`/journal/${post.slug}/`}>
        {post.image && <div class="page-image"><img src={post.image.src} alt={post.image.alt || ''} width={post.image.width} height={post.image.height} loading={index === 0 ? 'eager' : 'lazy'} /></div>}
        <div class="journal-card-copy"><p class="kick">{post.category}</p><h2>{post.title}</h2><p>{post.excerpt}</p><span class="text-link">Lire l’article <span aria-hidden="true">↗</span></span></div>
      </a>
    </article>)}
  </section>
  {page.body?.length > 0 && <section class="page-gutter page-reading-section"><div class="page-prose"><PortableText value={page.body} /></div></section>}
  <section class="page-cta page-gutter" data-page-reveal>
    {page.sections?.map((section: any) => <div><h2>{section.heading}</h2><p>{section.text}</p></div>)}
    <a class="btn" href="/catalogue/">{site.labels.catalogue}<span aria-hidden="true">↗</span></a>
  </section>
</PageLayout>
