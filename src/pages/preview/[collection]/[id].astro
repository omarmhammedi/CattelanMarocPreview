---
import { getRequestContext } from 'emdash';
import Home from '../../../components/Home.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import ModelCard from '../../../components/ModelCard.astro';
import SeoHead from '../../../components/SeoHead.astro';
import FamilyPage from '../../collections/[slug].astro';
import PostPage from '../../journal/[slug].astro';
import CollectionsPage from '../../collections/index.astro';
import JournalPage from '../../journal/index.astro';
import ShowroomPage from '../../showroom-casablanca.astro';
import CataloguePage from '../../catalogue.astro';
import {readEntry,homeModel,pageModel,familyModel,postModel,getFamilies,getPosts,getSite,getCatalogue,getHome,getPage,catalogueModel,picture} from '../../../lib/content';
const {collection,id}=Astro.params;
const preview=getRequestContext()?.preview;
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
if(!preview || preview.collection!==collection || preview.id!==id || !['pages','families','posts','site_content','catalogues','models'].includes(collection || '')) return new Response('Prévisualisation invalide ou expirée.',{status:404});
const entry=await readEntry(collection!,id!,collection==='families'?{models:{limit:20},related_post:true}:{});
if(!entry)return new Response('Contenu introuvable.',{status:404});
const site=await getSite();
const page=collection==='pages'?pageModel(entry):null;
const routeKey=entry.data.route_key;
const Template=collection==='families'?FamilyPage:collection==='posts'?PostPage:routeKey==='collections'?CollectionsPage:routeKey==='journal'?JournalPage:routeKey==='showroom'?ShowroomPage:routeKey==='catalogue'?CataloguePage:null;
const normalized=collection==='families'?familyModel(entry):collection==='posts'?postModel(entry):page;
const isHome=routeKey==='home'||collection==='site_content';
const home=isHome?(routeKey==='home'?homeModel(entry):await getHome()):null;
const cataloguePage=collection==='catalogues'?await getPage('catalogue'):null;
const model=collection==='models'?{title:entry.data.title,description:entry.data.description,image:picture(entry.data.image),officialUrl:entry.data.official_url}:null;
const [families,posts,catalogue]=isHome?await Promise.all([getFamilies(),getPosts(),getCatalogue()]):[[],[],null];
---
{isHome&&home ? <html lang="fr" data-mode="dark"><head><meta charset="utf-8"/><SeoHead title={home.seoTitle} description={home.description} site={site} entry={entry}/></head><body><Home home={home as any} families={families as any} posts={posts as any} site={site as any} catalogue={catalogue as any}/></body></html> : collection==='catalogues'&&cataloguePage ? <CataloguePage preloaded={cataloguePage} catalogueOverride={catalogueModel(entry)} previewOnly/> : model ? <PageLayout title={String(model.title)} site={site} entry={entry}><section class="page-intro page-gutter"><p class="kick">Prévisualisation de la fiche modèle</p><div class="model-grid"><ModelCard model={model}/></div></section></PageLayout> : Template ? <Template preloaded={normalized}/> : <p>Ce contenu est administrable depuis ses pages associées.</p>}
