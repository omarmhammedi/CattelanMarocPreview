---
import Home from '../components/Home.astro';
import SeoHead from '../components/SeoHead.astro';
import {getHome,getFamilies,getPosts,getSite,getCatalogue} from '../lib/content';
import {homeHeroImageAttributes,homePhotoSources,homeMobileMedia,homeDesktopMedia} from '../lib/home-images';
const [home,families,posts,site,catalogue]=await Promise.all([getHome(),getFamilies(),getPosts(),getSite(),getCatalogue()]);
if(!home) {Astro.response.status=503;throw new Error('Initialisez les contenus Cattelan dans EmDash avant de publier le site.');}
const heroPreload=homeHeroImageAttributes(home.heroImage);
const mobileHeroPreload=home.heroImage && heroPreload ? homePhotoSources(home.heroImage,heroPreload.sizes).mobileAvif : null;
// No href on the mobile responsive preload: browsers without imagesrcset
// support should discover the picture normally, not fetch a wrong-size fallback.
---
<!doctype html>
<html lang="fr" data-mode="dark"><head><meta charset="utf-8"/><SeoHead title={home.seoTitle} description={home.description} site={site} entry={home.entry} image={home.heroImage}/>{heroPreload && <link rel="preload" as="image" media={mobileHeroPreload ? homeDesktopMedia : undefined} href={heroPreload.src} imagesrcset={heroPreload.srcset} imagesizes={heroPreload.sizes} fetchpriority="high"/>}{mobileHeroPreload && <link rel="preload" as="image" media={homeMobileMedia} type="image/avif" imagesrcset={mobileHeroPreload.srcset} imagesizes={mobileHeroPreload.sizes} fetchpriority="high"/>}</head><body><Home home={home as any} families={families as any} posts={posts as any} site={site as any} catalogue={catalogue as any}/></body></html>
