---
import { imageAttributes } from '../../lib/images';
import PageLayout from '../../layouts/PageLayout.astro';
import ModelCard from '../../components/ModelCard.astro';
import SiteActions from '../../components/SiteActions.astro';
import { PortableText } from 'emdash/ui';
import { generalMessageFor, whatsappHref } from '../../lib/actions';
import { getFamily, getSite } from '../../lib/content';

const [family, site] = await Promise.all([Astro.props.preloaded || getFamily(Astro.params.slug || ''), getSite()]);
if (!family) return new Response('Collection introuvable', { status: 404 });
---
<PageLayout title={family.seoTitle || family.title} description={family.description} site={site} image={family.image} entry={family.entry}>
  <section class="page-intro page-gutter page-intro-family">
    <a class="kick breadcrumb" href="/collections/">← {site.labels.collections}</a>
    <h1 {...family.entry?.edit?.title}>{family.title}</h1>
    <p class="page-lead" {...family.entry?.edit?.intro}>{family.intro}</p>
  </section>
  {family.image && <figure class="page-gutter page-full-figure" data-page-reveal>
    <div class="page-image"><img {...imageAttributes(family.image, '100vw', 1600)} alt={family.image.alt || family.shortTitle} fetchpriority="high" /></div>
    {family.imageCaption && <figcaption>{family.imageCaption}</figcaption>}
  </figure>}
  {family.body?.length > 0 && <section class="page-gutter page-reading-section" data-page-reveal><div class="page-prose"><PortableText value={family.body} /></div></section>}
  {family.models?.length > 0 && <section class="page-gutter models-section">
    <div class="section-heading"><h2>Les modèles</h2></div>
    <div class="model-grid">
      {family.models.map((model: any) => <ModelCard model={model} />)}
    </div>
  </section>}
  {family.relatedPost && <section class="related-reading page-gutter" data-page-reveal>
    <p class="kick">À lire dans le Journal</p>
    <a href={`/journal/${family.relatedPost.slug}/`}><h2>{family.relatedPost.title}</h2><span class="text-link">{site.labels.readArticle} <span aria-hidden="true">↗</span></span></a>
  </section>}
  <section class="page-cta page-gutter" data-page-reveal>
    <h2 class="page-cta-heading">Showroom de Casablanca</h2>
    <SiteActions site={site} order={['appointment', 'advisor']} advisorHref={whatsappHref(site.whatsappUrl, generalMessageFor(site))} />
  </section>
</PageLayout>
