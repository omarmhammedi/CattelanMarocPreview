---
import ServicePage from '../components/ServicePage.astro';
import { getPage, getSite } from '../lib/content';

const [page, site] = await Promise.all([Astro.props.preloaded || getPage('a-propos'), getSite()]);
if (!page) return new Response('Page introuvable', { status: 404 });
---
<ServicePage page={page} site={site} order={['appointment', 'catalogue']} />
