---
import {PortableText} from 'emdash/ui';
import {env} from 'cloudflare:workers';
import PageLayout from '../layouts/PageLayout.astro';
import {getPage, getSite} from '../lib/content';
import {PRIVACY_PAGE} from '../lib/privacy-content.mjs';
import {privacyFacts, renderPrivacyContent} from '../lib/privacy';
const [page, site] = await Promise.all([Astro.props.preloaded || getPage('confidentialite'), getSite()]);
// The previous approved policy stays available until the new native page is published.
// Once a page exists, its body is authoritative; an intentionally empty value is not replaced.
const data = page?.entry?.data ?? PRIVACY_PAGE.data;
const runtime = env as unknown as {RESEND_API_KEY?: string; EMDASH_SITE_URL?: string};
const emailEnabled = Boolean(import.meta.env.CATTELAN_EMAIL_ENABLED && runtime.RESEND_API_KEY);
const catalogueEmailEnabled = emailEnabled && Boolean(runtime.EMDASH_SITE_URL);
const body = renderPrivacyContent(Array.isArray(data.content) ? data.content : [], privacyFacts(site, emailEnabled, catalogueEmailEnabled));
const title = page?.title ?? PRIVACY_PAGE.data.title;
---
<PageLayout title={page?.seoTitle || title} description={page?.description || PRIVACY_PAGE.data.meta_description} entry={page?.entry} site={site}>
  <section class="page-intro page-gutter">
    {data.eyebrow && <p class="kick" {...page?.entry?.edit?.eyebrow}>{data.eyebrow}</p>}
    <h1 {...page?.entry?.edit?.title}>{title}</h1>
    {data.intro && <p class="page-lead" {...page?.entry?.edit?.intro}>{data.intro}</p>}
    <div class="page-prose" {...page?.entry?.edit?.content}><PortableText value={body as any} /></div>
  </section>
</PageLayout>
