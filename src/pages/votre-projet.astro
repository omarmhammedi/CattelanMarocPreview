---
import ServicePage from '../components/ServicePage.astro';
import RequestForm from '../components/RequestForm.astro';
import { roomPhotoWhatsappMessage, whatsappHref } from '../lib/actions';
import { getPage, getSite } from '../lib/content';

const [page, site] = await Promise.all([Astro.props.preloaded || getPage('votre-projet'), getSite()]);
if (!page) return new Response('Page introuvable', { status: 404 });
const photoHref = whatsappHref(site.whatsappUrl, roomPhotoWhatsappMessage);
---
<ServicePage page={page} site={site} order={['appointment', 'advisor']}>
  <Fragment slot="form">
    <h2>Demande de conseil</h2>
    {photoHref && <p><a class="btn" href={photoHref} target="_blank" rel="noopener noreferrer">Envoyer une photo de la pièce <span aria-hidden="true">↗</span></a></p>}
    <RequestForm id="project-request" kind="projet" site={site} />
  </Fragment>
</ServicePage>
