---
interface Props { site: any; }
const { site } = Astro.props;
---
<a class="page-brand" href="/" aria-label={`${site.name} — Accueil`}>
  {site.logoDark ? <img class="lg-w" src={site.logoDark.src} alt={site.name} width="180" height="57" /> : <span class="brand-name lg-w">{site.name}</span>}
  {site.logoLight ? <img class="lg-r" src={site.logoLight.src} alt={site.name} width="180" height="57" /> : <span class="brand-name lg-r">{site.name}</span>}
  {site.location && <span class:list={['loc', { 'loc-long': site.location.length > 8 }]}>{site.location}</span>}
</a>
