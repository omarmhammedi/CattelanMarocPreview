---
import { imageAttributes } from '../lib/images';
import '../styles/models.css';
import {PortableText} from 'emdash/ui';
import SiteActions from './SiteActions.astro';
import {finishGroupLabel, finishHasSeparateCode, finishNameLabel} from '../lib/model-labels';

interface Picture {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
  caption?: string;
}
interface Dimension {
  label?: string;
  value?: string;
  seats?: number;
  largeSeats?: number;
}
interface Drawing {
  label?: string;
  row?: number | string;
  column?: number | string;
  image: Picture;
}
interface Finish {
  group?: string;
  materialGroup?: string;
  material?: string;
  name?: string;
  code?: string;
  image?: Picture | null;
}
interface Props {
  model: {
    title: string;
    slug?: string;
    description?: string;
    body?: any[];
    year?: string | number;
    image?: Picture | null;
    imageCaption?: string;
    gallery?: Picture[];
    dimensions?: Dimension[];
    drawings?: Drawing[];
    finishes?: Finish[];
    technicalSheet?: {src: string; filename?: string} | null;
    technicalSheetLabel?: string;
    source_url?: string;
    officialUrl?: string;
    availabilityNote?: string;
    onDisplay?: boolean;
    entry?: any;
    href?: string;
  };
  site: any;
  families?: {title: string; href: string}[];
  advisorHref?: string | null;
}

const {model, site, families = [], advisorHref} = Astro.props;
const family = families.find(item => item.title && item.href);
const collectionLabel = site.labels?.collections || 'Collections';
// Terms stated in the project FAQ (Personnalisation, Livraison); they apply to every catalogue model.
const services = ['Personnalisable', 'Délai 10 à 12 semaines', 'Livraison partout au Maroc, offerte à Casablanca', 'Installation incluse'];
const advisorLabel = `Être conseillé sur ${model.title}`;
const sourceUrl = model.source_url || model.officialUrl;
const modelNotice = String(site.modelNotice || '').trim();
const gallery = (model.gallery || []).filter(picture => picture?.src);
const dimensions = (model.dimensions || []).filter(item => item.value || item.seats || item.largeSeats);
const drawings = (model.drawings || []).filter(item => item.image?.src).sort((a, b) =>
  (Number(a.row) || 0) - (Number(b.row) || 0) || (Number(a.column) || 0) - (Number(b.column) || 0));
const finishGroups = new Map<string, {label: string; finishes: Finish[]}>();
// Match the two/three/four-column grid, including the width of a contained
// image within its 1.25-ratio frame. Keep DPR 2 detail at normal desktop widths;
// each link retains access to the original without changing this presentation.
function finishImageSizes(image: Picture) {
  const ratio = image.width && image.height ? image.width / image.height : 1.25;
  const factor = Math.min(1, ratio / 1.25);
  return `(max-width: 500px) calc((50vw - max(20px, 4.4vw) - 10px) * ${factor}), (max-width: 850px) calc((30.4vw - 16px) * ${factor}), calc(20.55vw * ${factor})`;
}
for (const finish of model.finishes || []) {
  if (!finish.name && !finish.code && !finish.image?.src) continue;
  const key = JSON.stringify([finish.group || '', finish.materialGroup || '', finish.material || '']);
  const group = finishGroups.get(key) || {label: finishGroupLabel(finish), finishes: []};
  group.finishes.push(finish);
  finishGroups.set(key, group);
}
---
<article class="model-detail">
  <section class="page-intro page-gutter model-detail-hero">
    <nav class="model-breadcrumb" aria-label="Fil d’Ariane">
      <ol>
        <li><a href="/collections/">{collectionLabel}</a></li>
        {family && <li><a href={family.href}>{family.title}</a></li>}
        <li aria-current="page">{model.title}</li>
      </ol>
    </nav>
    <div class:list={['model-hero-grid', {'model-hero-with-image': !!model.image?.src}]}>
      <div class="model-hero-copy">
        <p class="kick">{site.name}</p>
        <h1 {...model.entry?.edit?.title}>{model.title}</h1>
        {model.onDisplay && <p class="model-on-display" {...model.entry?.edit?.on_display}>Exposé au showroom de Casablanca</p>}
        <ul class="model-services" aria-label="Services">{services.map(service => <li>{service}</li>)}</ul>
        {model.description && <p class="page-lead" {...model.entry?.edit?.description}>{model.description}</p>}
        {model.year && <dl class="model-year"><div><dt>Année</dt><dd>{model.year}</dd></div></dl>}
        {model.availabilityNote && <p class="page-note model-availability">{model.availabilityNote}</p>}
        <SiteActions order={['appointment', 'advisor']} advisorHref={advisorHref} advisorLabel={advisorLabel} />
      </div>
      {model.image?.src && <figure class="model-hero-figure">
        <div class="page-image model-hero-image"><img {...imageAttributes(model.image, '(max-width: 850px) 100vw, 54vw', 1600)} alt={model.image.alt || model.title} fetchpriority="high" /></div>
        {(model.imageCaption || model.image.caption) && <figcaption class="page-note">{model.imageCaption || model.image.caption}</figcaption>}
      </figure>}
    </div>
  </section>

  {model.body && model.body.length > 0 && <section class="page-gutter model-story" aria-labelledby="model-story-heading" data-page-reveal>
    <h2 class="kick" id="model-story-heading">Le modèle</h2>
    <div class="page-prose"><PortableText value={model.body} /></div>
  </section>}

  {gallery.length > 0 && <section class="page-gutter model-gallery" aria-labelledby="model-gallery-heading">
    <div class="section-heading" data-page-reveal><h2 id="model-gallery-heading">Photos</h2></div>
    {gallery.length > 1 && <nav class="model-gallery-thumbnails" aria-label={`Les vues de ${model.title}`}>
      {gallery.map((picture, index) => <a href={`#model-view-${index + 1}`} aria-label={`${model.title} — voir la vue ${index + 1}`}>
        <img {...imageAttributes(picture, '(max-width: 500px) 70px, clamp(70px, 8vw, 116px)', 240)} alt="" loading="lazy" />
        <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      </a>)}
    </nav>}
    <div class="model-gallery-grid">
      {gallery.map((picture, index) => <figure id={`model-view-${index + 1}`} class="model-gallery-view" tabindex="-1" data-page-reveal>
        <div class="page-image"><img {...imageAttributes(picture, index % 3 === 0 ? '92vw' : '(max-width: 500px) 100vw, 45vw', 1600)} alt={picture.alt || `${model.title} — vue ${index + 1}`} loading="lazy" /></div>
        {picture.caption && <figcaption class="page-note">{picture.caption}</figcaption>}
      </figure>)}
    </div>
  </section>}

  {(dimensions.length > 0 || drawings.length > 0 || model.technicalSheet?.src) && <section class="page-gutter model-technical" aria-labelledby="model-technical-heading">
    <div class="section-heading" data-page-reveal><h2 id="model-technical-heading">{dimensions.length > 0 || drawings.length > 0 ? 'Dimensions' : 'Fiche technique'}</h2></div>
    {dimensions.length > 0 && <dl class="model-dimensions">
      {dimensions.map(dimension => <div class="model-dimension" data-page-reveal>
        <dt>{dimension.label || 'Dimensions'}</dt>
        {dimension.value && <dd class="model-dimension-value">{dimension.value}</dd>}
        {(!!dimension.seats || !!dimension.largeSeats) && <dd class="model-seating">
          {!!dimension.seats && <span>{dimension.seats} {dimension.seats === 1 ? 'place' : 'places'} · chaises standard</span>}
          {!!dimension.largeSeats && <span>{dimension.largeSeats} {dimension.largeSeats === 1 ? 'place' : 'places'} · grandes chaises</span>}
        </dd>}
      </div>)}
    </dl>}
    {drawings.length > 0 && <div class="model-drawings">
      <h3>Plans et détails</h3>
      <div class="model-drawings-grid">{drawings.map(drawing => <figure data-page-reveal>
        <div class="model-dimension-drawing"><img src={drawing.image.src} alt={drawing.image.alt || `${model.title} — ${drawing.label || 'dessin technique'}`} width={drawing.image.width} height={drawing.image.height} loading="lazy" /></div>
        {drawing.label && <figcaption class="page-note">{drawing.label}</figcaption>}
      </figure>)}</div>
    </div>}
    {model.technicalSheet?.src && <a class="text-link model-technical-download" href={model.technicalSheet.src} download={model.technicalSheet.filename || true}>{model.technicalSheetLabel || 'Télécharger la fiche technique'} <span class="model-file-format">PDF</span><span aria-hidden="true">↓</span></a>}
  </section>}

  {finishGroups.size > 0 && <section class="page-gutter model-finishes" aria-labelledby="model-finishes-heading">
    <div class="section-heading" data-page-reveal><h2 id="model-finishes-heading">Finitions</h2></div>
    {[...finishGroups.values()].map(({label, finishes}) => <details class="model-finish-group" data-page-reveal>
      <summary><h3>{label || 'Finitions'}</h3><span class="model-finish-count">{finishes.length} {finishes.length === 1 ? 'finition' : 'finitions'}</span><span class="model-finish-toggle" aria-hidden="true">+</span></summary>
      <ul class="model-finish-list" role="list">
        {finishes.map(finish => <li class="model-finish">
          {finish.image?.src && <a class="model-finish-image model-finish-original" href={finish.image.src} target="_blank" rel="noopener noreferrer" aria-label={`Afficher l’échantillon original${finish.name || finish.code ? ` : ${[finish.name, finish.code].filter(Boolean).join(' — ')}` : ''} (nouvel onglet)`}>
            <img {...imageAttributes(finish.image, finishImageSizes(finish.image), 768)} alt={finish.image.alt || [finish.name, finish.code].filter(Boolean).join(' — ')} loading="lazy" />
          </a>}
          {finish.name && <p>{finishNameLabel(finish)}</p>}
          {finishHasSeparateCode(finish) && <span class="model-finish-code">{finish.code}</span>}
        </li>)}
      </ul>
    </details>)}
  </section>}

  {sourceUrl && <aside class="page-gutter model-source"><a class="text-link" href={sourceUrl} target="_blank" rel="noopener noreferrer">Voir la fiche Cattelan Italia<span aria-hidden="true">↗</span></a></aside>}

  <section class="page-cta page-gutter model-project" data-page-reveal>
    <SiteActions order={['appointment', 'advisor']} advisorHref={advisorHref} advisorLabel={advisorLabel} />
    {modelNotice && modelNotice !== model.availabilityNote?.trim() && <p class="page-note model-site-notice">{modelNotice}</p>}
  </section>
</article>
