---
interface Props {model:any;}
const {model}=Astro.props;
---
<article class="model-card" data-page-reveal>
 {model.image && <figure class="model-figure"><div class="page-image"><img src={model.image.src} alt={model.image.alt || model.title || model.name} width={model.image.width} height={model.image.height} loading="lazy"/></div>{model.imageCaption && <figcaption class="page-note">{model.imageCaption}</figcaption>}</figure>}
 <h3>{model.title || model.name}</h3><p>{model.description}</p>
 {model.availabilityNote && <p class="page-note">{model.availabilityNote}</p>}
 {model.officialUrl && <a class="text-link" href={model.officialUrl} target="_blank" rel="noopener noreferrer">Découvrir le modèle<span aria-hidden="true">↗</span></a>}
</article>
