---
import { coverSizes, imageAttributes } from '../lib/images';
interface Props {model:any;}
const {model}=Astro.props;
---
<article class="model-card" data-page-reveal>
 {model.image && <figure class="model-figure"><div class="page-image"><img {...imageAttributes(model.image, coverSizes(model.image, 1.2, 1.2, 45), 1600)} alt={model.image.alt || model.title || model.name} loading="lazy"/></div>{model.imageCaption && <figcaption class="page-note">{model.imageCaption}</figcaption>}</figure>}
 <h3>{model.title || model.name}</h3><p>{model.description}</p>
 {model.href && <a class="text-link" href={model.href}>Voir le modèle<span aria-hidden="true">↗</span></a>}
</article>
