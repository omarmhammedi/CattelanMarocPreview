---
import '../styles/site.css';
import { PortableText } from 'emdash/ui';
import CatalogueForm from './CatalogueForm.astro';
import HeaderActions from './HeaderActions.astro';
import SiteActions from './SiteActions.astro';
import ThemeToggle from './ThemeToggle.astro';
import NativeNav, { type NavigationItem } from './NativeNav.astro';
import GeographicMap from './GeographicMap.astro';
import GeographicMapSymbols from './GeographicMapSymbols.astro';
import { actions, generalWhatsappMessage, isCatalogueLink, whatsappHref } from '../lib/actions';
import { secondaryLinks, valetService } from '../lib/footer';
import { imageAttributes } from '../lib/images';

type Editable = { edit?: Record<string, Record<string, string>> };
type Picture = { src: string; alt: string; width?: number; height?: number } | null;
type CopySection = { key?: string; present?: boolean; heading: string; displayHeading?: string; text: string; ctaLabel?: string; ctaHref?: string; image?: Picture; imageField?: string };
interface Props {
  home: {
    entry?: Editable;
    body?: any[]; extraSections?: CopySection[];
    title: string; eyebrow: string; intro: string; heroImage: Picture;
    brand: CopySection & { image: Picture; detailImage: Picture; caption?: string };
    collections: CopySection;
    showroom: CopySection & { image: Picture; invitation?: string };
    catalogue: CopySection;
    journal: CopySection;
  };
  families: { entry?: Editable; title: string; shortTitle?: string; summary: string; href: string; image: Picture; models?: unknown[] }[];
  posts: { entry?: Editable; title: string; href: string; category: string; readingTime?: string; image: Picture }[];
  site: {
    entry?: Editable;
    name: string; tagline: string; location: string; navigation: NavigationItem[]; logoLight: Picture; logoDark: Picture;
    whatsappHref?: string | null; phone?: string; address?: string; hours?: string; mapUrl?: string;
    mapNote?: string; previewNotice?: string; footerNote?: string; publicEmail?: string; placeholderNotice?: string;
    showroomLatitude?: number | null; showroomLongitude?: number | null;
    form: Record<string, string>;
    labels: {
      collections: string; showroom: string; journal: string; catalogue: string;
      allArticles: string; discover: string; visit: string;
      scroll: string; readArticle: string; contact: string;
    };
  };
  catalogue: { entry?: Editable; id: string; title: string; edition: string; cover: Picture; isPlaceholder?: boolean; downloadLabel: string } | null;
}
const { home, families, posts, site, catalogue } = Astro.props;
const labels = site.labels;
const homeEdit = home.entry?.edit;
const siteEdit = site.entry?.edit;
const headerNavigation = site.navigation.filter(item => !isCatalogueLink(item.url));
const advisorHref = whatsappHref(site.whatsappHref, generalWhatsappMessage);
const featuredPost = posts[0];
const otherPosts = posts.slice(1, 5);
const hasCta = (section: CopySection) => !!(section.ctaLabel && section.ctaHref);
const extraSections = home.extraSections?.filter(section => section.heading || section.displayHeading || section.text || section.image || hasCta(section)) || [];
const catalogueImage = home.catalogue.image || catalogue?.cover;
// Keep the entrance sign visible when the showroom photograph is portrait.
const showroomPortrait = Boolean(home.showroom.image?.width && home.showroom.image.height && home.showroom.image.height > home.showroom.image.width);
const showroomImageStyle = { objectPosition: showroomPortrait ? 'center top' : 'center 62%', transformOrigin: showroomPortrait ? 'center top' : undefined };
// These frame proportions and focal points belong to version B’s family compositions, not list positions.
const familyFrames: Record<string, { ratio: number; position: number }> = {
  tables: { ratio: .889, position: 60 },
  "chaises-tabourets": { ratio: .889, position: 60 },
  "canapes-fauteuils": { ratio: .889, position: 62 },
  "buffets-bibliotheques": { ratio: .5624, position: 55 },
  luminaires: { ratio: .889, position: 55 },
  "mobilier-exterieur": { ratio: .5624, position: 55 },
  "tables-basses": { ratio: .5624, position: 60 },
  "consoles-miroirs": { ratio: .5624, position: 50 },
};
const familyFrame = (href: string) => familyFrames[href.split('/').filter(Boolean).at(-1) || ''] || { ratio: .889, position: 55 };
// Match responsive branches, accounting for the pixels enlarged by object-fit: cover.
// Size hints change the rendition only; version B's frame proportions stay in CSS.
const coverWidth = (image: Picture, width: string, height: string) => image?.width && image.height
  ? `max(${width}, calc(${height} * ${Number((image.width / image.height).toFixed(6))}))` : width;
const coverSizes = (image: Picture, width: string, height: string, mobileHeight: number, mobileWidth = 'calc(100vw - 40px)') =>
  `(max-width: 820px) ${coverWidth(image, mobileWidth, mobileHeight + 'px')}, ${coverWidth(image, width, height)}`;
const heroImageSizes = coverSizes(home.heroImage, '100vw', '116vh', 380 * 1.16);
const brandImageSizes = coverSizes(home.brand.image, 'min(38vw, 66vh)', 'calc(min(38vw, 66vh) * 1215 / 1080 * 1.16)', 420 * 1.16);
const detailImageSizes = coverWidth(home.brand.detailImage, 'min(15vw, 25vh)', 'calc(min(15vw, 25vh) * 1700 / 956 * 1.16)');
const showroomImageSizes = coverSizes(home.showroom.image, '100vw', '116vh', 320 * 1.16);
const catalogueImageSizes = coverSizes(catalogueImage || null, 'min(28vw, 50vh)', 'calc(min(28vw, 50vh) * 1.414)', 260 * 1.16);
const journalImageSizes = (image: Picture, featured: boolean) => coverSizes(image, featured ? '52vw' : '20vw', featured ? 'min(62vh, 44vw)' : 'min(13vw, 22.1vh)', 220 * 1.16);
const familyImageSizes = (family: Props['families'][number]) => coverSizes(family.image, `${familyFrame(family.href).ratio * 66}vh`, '60vh', 360 * 1.16, '78vw');

const explicitBrandLines = home.brand.heading.split(/\n+/).map(line => line.trim()).filter(Boolean);
const brandWords = home.brand.heading.split(/\s+/);
const brandBreak = brandWords.reduce((best, _word, index) => {
  if (index === 0 || index === brandWords.length || /^(à|au|aux|de|du|des|en|et|pour|le|la|les|un|une)$/i.test(brandWords[index - 1])) return best;
  const midpoint = home.brand.heading.length / 2;
  return Math.abs(brandWords.slice(0, index).join(' ').length - midpoint) < Math.abs(brandWords.slice(0, best).join(' ').length - midpoint) ? index : best;
}, 1);
const brandLines = explicitBrandLines.length > 1 ? explicitBrandLines : [brandWords.slice(0, brandBreak).join(' '), brandWords.slice(brandBreak).join(' ')].filter(Boolean);
---

<svg width="0" height="0" class="svg-symbols" aria-hidden="true">
  <defs>
    <symbol id="fan" viewBox="0 0 200 104">
      <g fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M4 102 A96 96 0 0 1 196 102"/><path d="M26 102 A74 74 0 0 1 174 102"/><path d="M48 102 A52 52 0 0 1 152 102"/><path d="M70 102 A30 30 0 0 1 130 102"/>
        <path d="M100 102 V6"/><path d="M100 102 L32 34"/><path d="M100 102 L168 34"/><path d="M100 102 L10 72"/><path d="M100 102 L190 72"/><path d="M100 102 L63 14"/><path d="M100 102 L137 14"/><path d="M2 102 H198"/>
      </g>
    </symbol>
    <symbol id="step" viewBox="0 0 44 24"><path d="M2 23 H42 M8 23 V15 H14 V9 H20 V3 H24 V9 H30 V15 H36 V23" fill="none" stroke="currentColor" stroke-width="1.6"/></symbol>
    <GeographicMapSymbols/>
  </defs>
</svg>
<a class="skip-link" href="#main-content">Aller au contenu</a>
<header class="hd" id="hd">
  <a class="logo" href="/#accueil" data-go="accueil" aria-label={`${site.name}, accueil`}>{site.logoDark ? <img class="lg-w" {...imageAttributes(site.logoDark, '180px', 512)} alt={site.logoDark.alt}/> : <span class="brand-name lg-w">{site.name}</span>}{site.logoLight ? <img class="lg-r" {...imageAttributes(site.logoLight, '180px', 512)} alt={site.logoLight.alt}/> : <span class="brand-name lg-r">{site.name}</span>}</a>
  <nav aria-label="Navigation principale">
    <NativeNav items={headerNavigation} />
  </nav>
  <div class="header-tools">
    <HeaderActions advisorHref={advisorHref} />
    <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation">Menu</button>
    <ThemeToggle />
  </div>
</header>
<nav id="mobile-navigation" class="mobile-navigation" aria-label="Navigation mobile" hidden>
  <NativeNav items={headerNavigation} />
  <HeaderActions variant="menu" />
</nav>

<main id="main-content" class="home">
<!-- One editorial tree: version B’s pinned scenes become normal-flow sections on mobile. -->
<div class="home-sections">
  <section class:list={['scene', {'without-visual': !(home.heroImage)}]} id="accueil" data-scene={(home.heroImage) ? 'hero' : undefined} style="--g: 0; --t: 0; --w: 0;">
    <div class="pin">
      <div class="words"><div>{home.eyebrow && <p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{home.eyebrow}</p>}<h1 {...homeEdit?.title}>{home.title}</h1></div><div class="side">{site.tagline && <p class="kick">{site.tagline}</p>}<span class="hint">{labels.scroll} ↓</span></div></div>
      {home.heroImage && <div class="ph card" data-mobile-frame {...homeEdit?.hero_image}><img {...imageAttributes(home.heroImage, heroImageSizes)} alt={home.heroImage.alt} fetchpriority="high" style="object-position: center 55%;"/><div class="veil"></div></div>}
      <div class:list={["over", {onphoto: !!home.heroImage}]}><div>{home.eyebrow && <p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{home.eyebrow}</p>}{home.intro && <p class="hero-intro" {...homeEdit?.intro}>{home.intro}</p>}<SiteActions order={['appointment', 'catalogue']} /></div></div>
    </div>
  </section>
  {home.brand.present !== false && <section class:list={['scene', {'without-visual': !(home.brand.image || home.brand.detailImage)}]} id="italie" data-scene={(home.brand.image || home.brand.detailImage) ? 'italie' : undefined} style="--a: 0; --o: 0;">
    <div class="pin">
      <div class="col" {...homeEdit?.sections}><p class="kick fade"><svg aria-hidden="true"><use href="#step"/></svg>{site.name}</p>{home.brand.heading && <h2 class="big" aria-label={home.brand.heading}>{brandLines.map((line, index) => <span><b>{index > 0 && ' '}{line}</b></span>)}</h2>}{home.brand.text && <p class="txt fade">{home.brand.text}</p>}{hasCta(home.brand) && <div class="row fade"><a class="btn" href={home.brand.ctaHref}>{home.brand.ctaLabel}</a></div>}</div>
      {home.brand.image && <div class="ph p1" data-mobile-frame {...homeEdit?.[home.brand.imageField || 'brand_image']}><img {...imageAttributes(home.brand.image, brandImageSizes)} alt={home.brand.image.alt} loading="lazy" style="object-position: center 55%;"/></div>}{home.brand.detailImage && <div class="ph p2" {...homeEdit?.brand_detail_image}><img {...imageAttributes(home.brand.detailImage, detailImageSizes)} alt={home.brand.detailImage.alt} loading="lazy" style="object-position: center 60%;"/></div>}
      {home.brand.caption && <span class="cap" {...homeEdit?.brand_caption}>{home.brand.caption}</span>}
    </div>
  </section>}
  {home.collections.present !== false && <section class="scene" id="collections" data-scene="collections" style={`--h: 0; --shift: 0; --count: ${families.length};`}>
    <div class="pin"><div class="track">
      <div class="intro" {...homeEdit?.sections}><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.collections}</p>{home.collections.heading && <h2 class="big" {...homeEdit?.sections}>{home.collections.heading}</h2>}{home.collections.text && <p class="txt" {...homeEdit?.sections}>{home.collections.text}</p>}{home.collections.image && <div class="section-image-frame" data-mobile-frame><img class="section-image" {...imageAttributes(home.collections.image, '(max-width: 820px) calc(100vw - 40px), 38vw')} alt={home.collections.image.alt} loading="lazy"/></div>}{hasCta(home.collections) && <div class="row"><a class="btn" href={home.collections.ctaHref}>{home.collections.ctaLabel}</a></div>}</div>
      <div class="family-rail" tabindex="0" aria-label={labels.collections}>{families.map((family, index) => <a class="cc" href={family.href} style={`--i: ${index}; --r: ${familyFrame(family.href).ratio};`}>{family.image && <div class="frame" data-mobile-frame><img {...imageAttributes(family.image, familyImageSizes(family))} alt={family.image.alt} loading="lazy" style={`object-position: center ${familyFrame(family.href).position}%;`}/></div>}<div class="nm"><b {...(family.shortTitle ? family.entry?.edit?.short_title : family.entry?.edit?.title)}>{family.shortTitle || family.title}</b><span>{family.models?.length ? `${family.models.length} ${family.models.length === 1 ? 'modèle' : 'modèles'}` : labels.discover} →</span></div><p {...family.entry?.edit?.card_text}>{family.summary}</p></a>)}
      {hasCta(home.catalogue) && <a class="cc cta" href={home.catalogue.ctaHref} style={`--i: ${families.length};`}><div class="frame"><svg class="deco" viewBox="0 0 200 104" aria-hidden="true"><use href="#fan"/></svg>{home.catalogue.heading && <p class="cta-heading">{home.catalogue.heading}</p>}<span class="btn solid">{home.catalogue.ctaLabel}</span></div><div class="nm"><b>Catalogue</b><span>PDF</span></div></a>}
      </div>
    </div><div class="bar" aria-hidden="true"><i></i></div></div>
  </section>}
  {home.showroom.present !== false && <section class:list={['scene', {'without-visual': !(home.showroom.image)}]} id="showroom" data-scene={(home.showroom.image) ? 'showroom' : undefined} style="--s: 0; --r: 0;">
    <div class="pin">{home.showroom.image && <div class="ph img" {...homeEdit?.[home.showroom.imageField || 'showroom_image']}><div class="showroom-photo" data-mobile-frame><img {...imageAttributes(home.showroom.image, showroomImageSizes)} alt={home.showroom.image.alt} loading="lazy" style={showroomImageStyle}/><div class="veil"></div></div>{home.showroom.invitation && <div class="say onphoto"><h2 class="big" {...homeEdit?.showroom_invitation}>{home.showroom.invitation}</h2></div>}</div>}
      <div class="info" {...homeEdit?.sections}>{!home.showroom.image && home.showroom.invitation && <p class="txt showroom-invitation" {...homeEdit?.showroom_invitation}>{home.showroom.invitation}</p>}{home.showroom.heading && <h2 class="big" {...homeEdit?.sections}>{home.showroom.heading}</h2>}{home.showroom.text && <p class="txt" {...homeEdit?.sections}>{home.showroom.text}</p>}<div class="row">{hasCta(home.showroom) && <a class="btn" href={home.showroom.ctaHref}>{home.showroom.ctaLabel}</a>}</div></div>
    </div>
  </section>}
  <section id="plan">
    <GeographicMap id="showroom-city-map" responsive name={site.name} latitude={site.showroomLatitude} longitude={site.showroomLongitude} mapUrl={site.mapUrl}/>
    <div class="panel"><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.showroom}</p><h2>Adresse et horaires</h2>{site.address && <p class="txt">{site.address}</p>}{site.hours && <p class="txt">{site.hours}</p>}<div class="row">{site.mapUrl && <a class="btn solid map-directions" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Itinéraire</a>}{hasCta(home.showroom) && <a class="btn" href={home.showroom.ctaHref}>{home.showroom.ctaLabel}</a>}</div></div>
    {site.mapNote && <span class="note">{site.mapNote}</span>}
  </section>
  {home.catalogue.present !== false && <section class:list={['scene', {'without-visual': !(catalogueImage)}]} id="catalogue" data-scene={(catalogueImage) ? 'catalogue' : undefined} style="--c: 0; --d: 0;">
    <div class="pin"><svg class="fan deco" viewBox="0 0 200 104" aria-hidden="true"><use href="#fan"/></svg>{catalogueImage && <div class:list={["book", {"section-cover": !!home.catalogue.image}]}><div class="b"><div class="pg" style="--n: 3;"></div><div class="pg" style="--n: 2;"></div><div class="pg" style="--n: 1;"></div><div class="cv" data-mobile-frame {...(home.catalogue.image ? homeEdit?.sections : catalogue?.entry?.edit?.cover)}>{catalogueImage && <img class="pic" {...imageAttributes(catalogueImage, catalogueImageSizes)} alt={home.catalogue.image?.alt || ""} loading="lazy"/>}<div class="t onphoto" aria-hidden="true">{site.logoDark ? <img class="lg-w keep" {...imageAttributes(site.logoDark, '180px', 512)} alt=""/> : <strong>{site.name}</strong>}{site.location && <span class="loc">{site.location}</span>}<span>{catalogue?.edition}</span></div></div></div></div>}
      <div class="form" {...homeEdit?.sections}>{catalogue?.title && <p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{catalogue.title}</p>}{home.catalogue.heading && <h2 class="big" {...homeEdit?.sections}>{home.catalogue.heading}</h2>}{home.catalogue.text && <p class="txt" {...homeEdit?.sections}>{home.catalogue.text}</p>}{catalogue?.isPlaceholder && site.placeholderNotice && <p class="legal" {...siteEdit?.placeholder_notice}>{site.placeholderNotice}</p>}<CatalogueForm id="home-catalogue" site={site} catalogue={catalogue} /></div>
    </div>
  </section>}
  {home.journal.present !== false && <section id="journal"><div class="top" {...homeEdit?.sections}><div><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.journal}</p>{home.journal.heading && <h2 class="big" {...homeEdit?.sections}>{home.journal.heading}</h2>}</div></div>{home.journal.text && <p class="txt journal-intro">{home.journal.text}</p>}{home.journal.image && <div class="journal-section-frame" data-mobile-frame><img class="journal-section-image" {...imageAttributes(home.journal.image, coverSizes(home.journal.image, '91.2vw', 'min(55vh, 36vw)', 260 * 1.16))} alt={home.journal.image.alt} loading="lazy"/></div>}
    <div class="jgrid">{featuredPost && <a class="art feat rv" href={featuredPost.href}>{featuredPost.image && <div class="im" data-mobile-frame><img {...imageAttributes(featuredPost.image, journalImageSizes(featuredPost.image, true))} alt={featuredPost.image.alt} loading="lazy"/></div>}<span class="meta">{featuredPost.category}{featuredPost.readingTime && ` · ${featuredPost.readingTime}`}</span><h3 {...featuredPost.entry?.edit?.title}>{featuredPost.title}</h3><span class="article-link">{labels.readArticle} <span aria-hidden="true">→</span></span></a>}<div class="jside">{otherPosts.map(post => <a class="art sm rv" href={post.href}>{post.image && <div class="im" data-mobile-frame><img {...imageAttributes(post.image, journalImageSizes(post.image, post.href === featuredPost?.href))} alt={post.image.alt} loading="lazy"/></div>}<div class="tx"><span class="meta">{post.category}{post.readingTime && ` · ${post.readingTime}`}</span><h3 {...post.entry?.edit?.title}>{post.title}</h3><span class="article-link">{labels.readArticle} <span aria-hidden="true">→</span></span></div></a>)}</div></div>
    {hasCta(home.journal) && <a class="btn journal-cta" href={home.journal.ctaHref}>{home.journal.ctaLabel}</a>}
  </section>}
</div>

{home.body && home.body.length > 0 && <section class="home-editorial"><div class="home-prose" {...homeEdit?.content}><PortableText value={home.body}/></div></section>}
{extraSections.map(section => <section class="home-editorial" {...homeEdit?.sections}><div class="home-prose">{(section.displayHeading || section.heading) && <h2 class="big">{section.displayHeading || section.heading}</h2>}{section.text && <p class="txt">{section.text}</p>}{section.image && <img class="editorial-image" {...imageAttributes(section.image, '(max-width: 820px) calc(100vw - 40px), min(66rem, 91.2vw)')} alt={section.image.alt} loading="lazy"/>}{hasCta(section) && <a class="btn" href={section.ctaHref}>{section.ctaLabel}</a>}</div></section>)}
</main>
<footer class="ft">
  <svg class="fan deco" viewBox="0 0 200 104" aria-hidden="true"><use href="#fan"/></svg><div class="brand">{site.logoDark ? <img class="lg-w" {...imageAttributes(site.logoDark, '180px', 512)} alt={site.logoDark.alt}/> : <span class="brand-name lg-w">{site.name}</span>}{site.logoLight ? <img class="lg-r" {...imageAttributes(site.logoLight, '180px', 512)} alt={site.logoLight.alt}/> : <span class="brand-name lg-r">{site.name}</span>}{site.location && <span class="loc">{site.location}</span>}{site.tagline && <p>{site.tagline}</p>}</div>
  <div><h4>{labels.showroom}</h4><ul><li>{site.name}</li>{site.address && <li>{site.address}</li>}{site.hours && <li>{site.hours}</li>}<li>{valetService}</li>{site.phone && <li><a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a></li>}{advisorHref && <li><a href={advisorHref} target="_blank" rel="noopener noreferrer" data-action="advisor" aria-label={`${actions.advisor.label} sur ${actions.advisor.channel}`}>{actions.advisor.label} <span aria-hidden="true">↗</span></a></li>}{site.publicEmail && <li><a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a></li>}<li><a href="/showroom-casablanca/">{labels.visit}</a></li></ul></div>
  <div><h4>Explorer</h4><ul>{site.navigation.map(item => <li><NativeNav items={[item]} /></li>)}{secondaryLinks(site.navigation).map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul></div>
  <div class="base"><span>{site.name}</span>{site.footerNote && <span {...siteEdit?.footer_text}>{site.footerNote}</span>}{site.previewNotice && <p class="preview-notice" {...siteEdit?.preview_notice}>{site.previewNotice}</p>}</div>
</footer>
<script>
  import '../scripts/site';
  import '../scripts/home';
</script>
