---
import '../styles/site.css';
import CatalogueForm from './CatalogueForm.astro';
import NativeNav, { type NavigationItem } from './NativeNav.astro';

type Editable = { edit?: Record<string, Record<string, string>> };
type Picture = { src: string; alt: string } | null;
type CopySection = { heading: string; text: string };
interface Props {
  home: {
    entry?: Editable;
    title: string; eyebrow: string; intro: string; heroImage: Picture;
    brand: CopySection & { image: Picture; detailImage: Picture; caption?: string };
    collections: CopySection;
    showroom: CopySection & { image: Picture; invitation?: string };
    catalogue: CopySection;
    journal: CopySection;
  };
  families: { entry?: Editable; title: string; shortTitle?: string; summary: string; href: string; image: Picture }[];
  posts: { entry?: Editable; title: string; href: string; category: string; readingTime?: string; image: Picture }[];
  site: {
    entry?: Editable;
    name: string; tagline: string; location: string; navigation: NavigationItem[]; logoLight: Picture; logoDark: Picture;
    whatsappHref?: string | null; phone?: string; address?: string; hours?: string; mapUrl?: string;
    mapNote?: string; previewNotice?: string; footerNote?: string;
    labels: {
      collections: string; showroom: string; journal: string; catalogue: string;
      allArticles: string; discover: string; visit: string; appointment: string;
      download: string; scroll: string;
    };
  };
  catalogue: { entry?: Editable; title: string; edition: string; cover: Picture } | null;
}
const { home, families, posts, site, catalogue } = Astro.props;
const labels = site.labels;
const homeEdit = home.entry?.edit;
const siteEdit = site.entry?.edit;
const catalogueInNavigation = site.navigation.some(item => item.url === '/catalogue/');
const featuredPost = posts[0];
const otherPosts = posts.slice(1, 5);
const brandWords = home.brand.heading.split(' ');
const brandBreak = brandWords.reduce((best, _word, index) => {
  if (index === 0 || index === brandWords.length) return best;
  const midpoint = home.brand.heading.length / 2;
  return Math.abs(brandWords.slice(0, index).join(' ').length - midpoint) < Math.abs(brandWords.slice(0, best).join(' ').length - midpoint) ? index : best;
}, 1);
const brandLines = [brandWords.slice(0, brandBreak).join(' '), brandWords.slice(brandBreak).join(' ')].filter(Boolean);
---

<svg width="0" height="0" class="svg-symbols" aria-hidden="true">
  <defs>
    <symbol id="fan" viewBox="0 0 200 104">
      <g fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M4 102 A96 96 0 0 1 196 102"/><path d="M26 102 A74 74 0 0 1 174 102"/><path d="M48 102 A52 52 0 0 1 152 102"/><path d="M70 102 A30 30 0 0 1 130 102"/>
        <path d="M100 102 V6"/><path d="M100 102 L32 34"/><path d="M100 102 L168 34"/><path d="M100 102 L10 72"/><path d="M100 102 L190 72"/><path d="M100 102 L63 14"/><path d="M100 102 L137 14"/><path d="M2 102 H198"/>
      </g>
    </symbol>
    <symbol id="step" viewBox="0 0 44 24"><path d="M2 23 H42 M8 23 V15 H14 V9 H20 V3 H24 V9 H30 V15 H36 V23" fill="none" stroke="currentColor" stroke-width="1.6"/></symbol>
    <symbol id="city-map" viewBox="0 0 1440 900">
      <rect class="m-land" width="1440" height="900"/>
      <path class="m-sea" d="M0 0 H1440 V150 C1300 170 1180 120 1060 170 C930 225 820 250 700 285 C590 318 470 330 380 390 C300 445 190 470 0 520 Z"/>
      <path class="m-coast" d="M0 520 C190 470 300 445 380 390 C470 330 590 318 700 285 C820 250 930 225 1060 170 C1180 120 1300 170 1440 150" fill="none" stroke-width="1.5"/>
      <g class="m-grid" stroke-width="1" fill="none">
        <path d="M0 600 L1440 380 M0 690 L1440 470 M0 780 L1440 560 M60 900 L1440 650 M400 900 L1440 740"/>
        <path d="M300 900 L520 330 M500 900 L700 290 M700 900 L860 240 M900 900 L1020 185 M1100 900 L1180 150 M1300 900 L1330 160"/>
      </g>
      <g class="m-road" stroke-width="2" fill="none"><path d="M120 900 C260 700 420 560 700 480 S1180 330 1440 300 M620 900 C640 760 700 600 760 470 M980 900 C940 720 900 560 860 420"/></g>
      <g font-family="Helvetica Neue, Helvetica, Arial, sans-serif" font-size="14" letter-spacing="3">
        <text class="m-sea-lbl" x="760" y="120" font-size="16" letter-spacing="6">OCÉAN ATLANTIQUE</text>
        <text class="m-lbl" x="150" y="455">CORNICHE · AÏN DIAB</text><text class="m-lbl" x="300" y="610">ANFA</text>
        <text class="m-lbl" x="600" y="760">MAÂRIF</text><text class="m-lbl" x="1110" y="330">CENTRE-VILLE</text><text class="m-lbl" x="1250" y="215">PORT</text>
        <text class="m-hi" x="742" y="428" font-size="15" letter-spacing="4">CASABLANCA</text>
      </g>
      <g transform="translate(806 530)"><circle r="16" fill="none" stroke="#DB0812" stroke-width="2" class="pulse"/><circle r="7" fill="#DB0812"/></g>
    </symbol>
  </defs>
</svg>
<a class="skip-link" href="#main-content">Aller au contenu</a>
<header class="hd" id="hd">
  <a class="logo" href="/" aria-label={`${site.name}, accueil`}>{site.logoDark && <img class="lg-w" src={site.logoDark.src} alt={site.logoDark.alt} width="180" height="57"/>}{site.logoLight && <img class="lg-r" src={site.logoLight.src} alt={site.logoLight.alt} width="180" height="57"/>}<span class="loc">{site.location}</span></a>
  <nav aria-label="Navigation principale">
    <span class="status" id="status"><i aria-hidden="true"></i><span id="clock">Casablanca</span></span>
    {site.navigation.map(item => <Fragment>{item.url === '/catalogue/' && <span class="mode" role="group" aria-label="Apparence"><button type="button" data-mode="dark" aria-pressed="true">Sombre</button><button type="button" data-mode="light" aria-pressed="false">Clair</button></span>}<NativeNav items={[item]} variant="header" /></Fragment>)}
    {!catalogueInNavigation && <span class="mode" role="group" aria-label="Apparence"><button type="button" data-mode="dark" aria-pressed="true">Sombre</button><button type="button" data-mode="light" aria-pressed="false">Clair</button></span>}
  </nav>
  <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation">Menu</button>
</header>
<nav id="mobile-navigation" class="mobile-navigation" aria-label="Navigation mobile" hidden>
  <NativeNav items={site.navigation} variant="mobile" />
</nav>

<main id="main-content" class="home">
<div class="desk">
  <section class="scene" id="accueil" data-scene="hero" style="--g: 0; --t: 0; --w: 0;">
    <div class="pin">
      <div class="words"><div><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{home.eyebrow}</p><h1 {...homeEdit?.title}>{home.title}</h1></div><div class="side"><p class="kick">{site.tagline}</p><span class="hint">{labels.scroll} ↓</span></div></div>
      <div class="ph card" {...homeEdit?.hero_image}>{home.heroImage && <img src={home.heroImage.src} alt={home.heroImage.alt} fetchpriority="high" style="object-position: center 55%;"/>}<div class="veil"></div></div>
      <div class="over onphoto"><div><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{home.eyebrow}</p><h2 {...homeEdit?.intro}>{home.intro}</h2><div class="row"><a class="btn solid" href="/catalogue/" {...siteEdit?.catalogue_label}>{labels.download}</a><a class="btn" href="/showroom-casablanca/">{labels.visit}</a></div></div></div>
    </div>
  </section>
  <section class="scene" id="italie" data-scene="italie" style="--a: 0; --o: 0;">
    <div class="pin">
      <div class="col" {...homeEdit?.sections}><p class="kick fade"><svg aria-hidden="true"><use href="#step"/></svg>{site.name}</p><h2 class:list={['big', { 'long-heading': home.brand.heading.length > 24 }]}>{brandLines.map(line => <span><b>{line}</b></span>)}</h2><p class="txt fade">{home.brand.text}</p><div class="row fade"><a class="btn" href="/collections/">{labels.collections}</a></div></div>
      <div class="ph p1" {...homeEdit?.brand_image}>{home.brand.image && <img src={home.brand.image.src} alt={home.brand.image.alt} loading="lazy" style="object-position: center 55%;"/>}</div><div class="ph p2" {...homeEdit?.brand_detail_image}>{home.brand.detailImage && <img src={home.brand.detailImage.src} alt={home.brand.detailImage.alt} loading="lazy" style="object-position: center 60%;"/>}</div>
      {home.brand.caption && <span class="cap" {...homeEdit?.brand_caption}>{home.brand.caption}</span>}
    </div>
  </section>
  <section class="scene" id="collections" data-scene="collections" style={`--h: 0; --shift: 0; --count: ${families.length};`}>
    <div class="pin"><div class="track">
      <div class="intro" {...homeEdit?.sections}><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.collections}</p><h2 class="big" {...homeEdit?.sections}>{home.collections.heading}</h2><p class="txt" {...homeEdit?.sections}>{home.collections.text}</p></div>
      {families.map((family, index) => <a class="cc" href={family.href} style={`--i: ${index}; --r: ${index === 3 || index === 5 ? '.5624' : '.889'};`}><div class="frame">{family.image && <img src={family.image.src} alt={family.image.alt} loading="lazy" style="object-position: center 55%;"/>}</div><div class="nm"><b {...(family.shortTitle ? family.entry?.edit?.short_title : family.entry?.edit?.title)}>{family.shortTitle || family.title}</b><span>{labels.discover} →</span></div><p {...family.entry?.edit?.card_text}>{family.summary}</p></a>)}
      <a class="cc cta" href="/catalogue/" style={`--i: ${families.length};`}><div class="frame"><svg class="deco" viewBox="0 0 200 104" aria-hidden="true"><use href="#fan"/></svg><h3>{home.catalogue.heading}</h3><span class="btn solid">{labels.download}</span></div><div class="nm"><b>{labels.catalogue}</b><span>PDF</span></div></a>
    </div><div class="bar" aria-hidden="true"><i></i></div></div>
  </section>
  <section class="scene" id="showroom" data-scene="showroom" style="--s: 0; --r: 0;">
    <div class="pin"><div class="ph img" {...homeEdit?.showroom_image}>{home.showroom.image && <img src={home.showroom.image.src} alt={home.showroom.image.alt} loading="lazy" style="object-position: center 62%;"/>}<div class="veil"></div>{home.showroom.invitation && <div class="say onphoto"><h2 class="big" {...homeEdit?.showroom_invitation}>{home.showroom.invitation}</h2></div>}</div>
      <div class="info" {...homeEdit?.sections}><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.showroom}</p><h2 class="big" {...homeEdit?.sections}>{home.showroom.heading}</h2><p class="txt" {...homeEdit?.sections}>{home.showroom.text}</p><dl class="facts">{site.address && <div><dt>Adresse</dt><dd {...siteEdit?.address}>{site.address}</dd></div>}{site.hours && <div><dt>Horaires</dt><dd {...siteEdit?.hours}>{site.hours}</dd></div>}<Fragment>{site.phone && <div><dt>Téléphone{site.whatsappHref && ' · WhatsApp'}</dt><dd {...siteEdit?.contact_phone}>{site.whatsappHref ? <a href={site.whatsappHref}>{site.phone}</a> : site.phone}</dd></div>}</Fragment></dl><div class="row">{site.whatsappHref && <a class="btn red" href={site.whatsappHref} target="_blank" rel="noopener noreferrer">{labels.appointment}</a>}<a class="btn" href="/showroom-casablanca/">{labels.visit}</a></div></div>
    </div>
  </section>
  <section id="plan">
    <svg class="map" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Illustration de Casablanca"><use href="#city-map"/></svg>
    <div class="panel"><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.showroom}</p><h2>{site.name}</h2>{site.address && <p class="txt">{site.address}</p>}{site.hours && <p class="txt">{site.hours}</p>}<div class="row">{site.mapUrl && <a class="btn solid" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Itinéraire</a>}<a class="btn" href="/showroom-casablanca/">{labels.visit}</a></div></div>
    {site.mapNote && <span class="note">{site.mapNote}</span>}
  </section>
  <section class="scene" id="catalogue" data-scene="catalogue" style="--c: 0; --d: 0;">
    <div class="pin"><svg class="fan deco" viewBox="0 0 200 104" aria-hidden="true"><use href="#fan"/></svg><div class="book" aria-hidden="true"><div class="b"><div class="pg" style="--n: 3;"></div><div class="pg" style="--n: 2;"></div><div class="pg" style="--n: 1;"></div><div class="cv" {...catalogue?.entry?.edit?.cover}>{catalogue?.cover && <img class="pic" src={catalogue.cover.src} alt="" loading="lazy"/>}<div class="t onphoto">{site.logoDark && <img class="lg-w keep" src={site.logoDark.src} alt=""/>}<span class="loc">{site.location}</span><span>{catalogue?.edition}</span></div></div></div></div>
      <div class="form" {...homeEdit?.sections}><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{catalogue?.title}</p><h2 class="big" {...homeEdit?.sections}>{home.catalogue.heading}</h2><p class="txt" {...homeEdit?.sections}>{home.catalogue.text}</p><CatalogueForm id="home-desktop" /></div>
    </div>
  </section>
  <section id="journal"><div class="top" {...homeEdit?.sections}><div><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.journal}</p><h2 class="big" {...homeEdit?.sections}>{home.journal.heading}</h2></div><a class="btn" href="/journal/">{labels.allArticles}</a></div><p class="txt journal-intro">{home.journal.text}</p>
    <div class="jgrid">{featuredPost && <a class="art feat rv" href={featuredPost.href}><div class="im">{featuredPost.image && <img src={featuredPost.image.src} alt={featuredPost.image.alt} loading="lazy"/>}</div><span class="meta">{featuredPost.category}{featuredPost.readingTime && ` · ${featuredPost.readingTime}`}</span><h3 {...featuredPost.entry?.edit?.title}>{featuredPost.title}</h3></a>}<div class="jside">{otherPosts.map(post => <a class="art sm rv" href={post.href}><div class="im">{post.image && <img src={post.image.src} alt={post.image.alt} loading="lazy"/>}</div><div class="tx"><span class="meta">{post.category}{post.readingTime && ` · ${post.readingTime}`}</span><h3 {...post.entry?.edit?.title}>{post.title}</h3></div></a>)}</div></div>
  </section>
</div>

<div class="mob m">
  <section id="m-accueil"><h1 class="big" {...homeEdit?.title}>{home.title}</h1><div class="mimg m-hero-image" {...homeEdit?.hero_image}>{home.heroImage && <img src={home.heroImage.src} alt={home.heroImage.alt} fetchpriority="high" style="object-position: center 55%;"/>}</div><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{home.eyebrow}</p><p class="txt" {...homeEdit?.intro}>{home.intro}</p><div class="row"><a class="btn solid" href="/catalogue/" {...siteEdit?.catalogue_label}>{labels.download}</a><a class="btn" href="/showroom-casablanca/">{labels.visit}</a></div></section>
  <section id="m-italie"><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{site.name}</p><h2 class="big" {...homeEdit?.sections}>{home.brand.heading}</h2><p class="txt" {...homeEdit?.sections}>{home.brand.text}</p><div class="mimg m-brand-image" {...homeEdit?.brand_image}>{home.brand.image && <img src={home.brand.image.src} alt={home.brand.image.alt} loading="lazy"/>}</div></section>
  <section id="m-collections"><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.collections}</p><h2 class="big" {...homeEdit?.sections}>{home.collections.heading}</h2><p class="txt" {...homeEdit?.sections}>{home.collections.text}</p><div class="hscroll" tabindex="0" aria-label={labels.collections}>{families.map(family => <a href={family.href}><div class="mimg m-family-image">{family.image && <img src={family.image.src} alt={family.image.alt} loading="lazy" style="object-position: center 55%;"/>}</div><b class="m-family-title">{family.shortTitle || family.title}</b><span class="txt m-family-summary">{family.summary}</span></a>)}</div></section>
  <section id="m-showroom"><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.showroom}</p><h2 class="big" {...homeEdit?.sections}>{home.showroom.heading}</h2><div class="mimg m-showroom-image" {...homeEdit?.showroom_image}>{home.showroom.image && <img src={home.showroom.image.src} alt={home.showroom.image.alt} loading="lazy" style="object-position: center 62%;"/>}</div><p class="txt" {...homeEdit?.sections}>{home.showroom.text}</p><dl class="facts">{site.address && <div><dt>Adresse</dt><dd {...siteEdit?.address}>{site.address}</dd></div>}{site.hours && <div><dt>Horaires</dt><dd {...siteEdit?.hours}>{site.hours}</dd></div>}<Fragment>{site.phone && <div><dt>Téléphone{site.whatsappHref && ' · WhatsApp'}</dt><dd {...siteEdit?.contact_phone}>{site.whatsappHref ? <a href={site.whatsappHref}>{site.phone}</a> : site.phone}</dd></div>}</Fragment></dl><div class="row">{site.whatsappHref && <a class="btn red" href={site.whatsappHref} target="_blank" rel="noopener noreferrer">{labels.appointment}</a>}<a class="btn" href="/showroom-casablanca/">{labels.visit}</a></div></section>
  <section id="m-plan"><svg class="map" preserveAspectRatio="xMidYMid meet" viewBox="0 0 1440 900" role="img" aria-label="Illustration de Casablanca"><use href="#city-map"/></svg>{site.mapNote && <p class="legal">{site.mapNote}</p>}{site.mapUrl && <a class="btn solid" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Itinéraire</a>}</section>
  <section id="m-catalogue"><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{catalogue?.title}</p><h2 class="big" {...homeEdit?.sections}>{home.catalogue.heading}</h2><p class="txt" {...homeEdit?.sections}>{home.catalogue.text}</p><CatalogueForm id="home-mobile" /></section>
  <section id="m-journal"><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.journal}</p><h2 class="big" {...homeEdit?.sections}>{home.journal.heading}</h2><p class="txt" {...homeEdit?.sections}>{home.journal.text}</p>{posts.slice(0, 5).map(post => <a class="jart" href={post.href}><div class="mimg m-journal-image">{post.image && <img src={post.image.src} alt={post.image.alt} loading="lazy"/>}</div><span class="kick">{post.category}{post.readingTime && ` · ${post.readingTime}`}</span><h3 {...post.entry?.edit?.title}>{post.title}</h3></a>)}<a class="btn" href="/journal/">{labels.allArticles}</a></section>
</div>
</main>
<footer class="ft">
  <svg class="fan deco" viewBox="0 0 200 104" aria-hidden="true"><use href="#fan"/></svg><div class="brand">{site.logoDark && <img class="lg-w" src={site.logoDark.src} alt={site.logoDark.alt} width="180" height="57"/>}{site.logoLight && <img class="lg-r" src={site.logoLight.src} alt={site.logoLight.alt} width="180" height="57"/>}<span class="loc">{site.location}</span><p>{site.tagline}</p></div>
  <div><h4>{labels.showroom}</h4><ul>{site.address && <li>{site.address}</li>}{site.hours && <li>{site.hours}</li>}{site.phone && <li>{site.whatsappHref ? <a href={site.whatsappHref}>{site.phone} · WhatsApp</a> : site.phone}</li>}<li><a href="/showroom-casablanca/">{labels.visit}</a></li></ul></div>
  <div><h4>Explorer</h4><ul>{site.navigation.map(item => <li><NativeNav items={[item]} variant="footer" /></li>)}<li><a href="/confidentialite/">Confidentialité</a></li></ul></div>
  <div class="base"><span>{site.name}</span>{site.footerNote && <span {...siteEdit?.footer_text}>{site.footerNote}</span>}{site.previewNotice && <p class="preview-notice" {...siteEdit?.preview_notice}>{site.previewNotice}</p>}</div>
</footer>
<script>
  import '../scripts/site';
  import '../scripts/home';
</script>
