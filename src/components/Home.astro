---
import '../styles/site.css';
import { PortableText } from 'emdash/ui';
import CatalogueForm from './CatalogueForm.astro';
import ThemeToggle from './ThemeToggle.astro';
import NativeNav, { type NavigationItem } from './NativeNav.astro';

type Editable = { edit?: Record<string, Record<string, string>> };
type Picture = { src: string; alt: string } | null;
type CopySection = { key?: string; present?: boolean; heading: string; displayHeading?: string; text: string; ctaLabel?: string; ctaHref?: string; image?: Picture; imageField?: string };
interface Props {
  home: {
    entry?: Editable;
    body?: any[]; extraSections?: CopySection[];
    title: string; eyebrow: string; intro: string; heroImage: Picture;
    brand: CopySection & { image: Picture; detailImage: Picture; caption?: string };
    collections: CopySection;
    showroom: CopySection & { image: Picture; invitation?: string };
    catalogue: CopySection;
    journal: CopySection;
  };
  families: { entry?: Editable; title: string; shortTitle?: string; summary: string; href: string; image: Picture }[];
  posts: { entry?: Editable; title: string; href: string; category: string; readingTime?: string; image: Picture }[];
  site: {
    entry?: Editable;
    name: string; tagline: string; location: string; navigation: NavigationItem[]; logoLight: Picture; logoDark: Picture;
    whatsappHref?: string | null; phone?: string; address?: string; hours?: string; mapUrl?: string;
    mapNote?: string; previewNotice?: string; footerNote?: string; publicEmail?: string; placeholderNotice?: string;
    labels: {
      collections: string; showroom: string; journal: string; catalogue: string;
      allArticles: string; discover: string; visit: string; appointment: string;
      download: string; scroll: string; readArticle: string;
    };
  };
  catalogue: { entry?: Editable; title: string; edition: string; cover: Picture; isPlaceholder?: boolean } | null;
}
const { home, families, posts, site, catalogue } = Astro.props;
const labels = site.labels;
const homeEdit = home.entry?.edit;
const siteEdit = site.entry?.edit;
const featuredPost = posts[0];
const otherPosts = posts.slice(1, 5);
const hasContact = site.address || site.hours || site.phone || site.publicEmail;
const hasCta = (section: CopySection) => !!(section.ctaLabel && section.ctaHref);
const extraSections = home.extraSections?.filter(section => section.heading || section.displayHeading || section.text || section.image || hasCta(section)) || [];
const catalogueImage = home.catalogue.image || catalogue?.cover;
// These frame proportions and focal points belong to version B’s family compositions, not list positions.
const familyFrames: Record<string, { ratio: number; position: number }> = {
  tables: { ratio: .889, position: 60 },
  "chaises-tabourets": { ratio: .889, position: 60 },
  "canapes-fauteuils": { ratio: .889, position: 62 },
  "buffets-bibliotheques": { ratio: .5624, position: 55 },
  luminaires: { ratio: .889, position: 55 },
  "mobilier-exterieur": { ratio: .5624, position: 55 },
};
const familyFrame = (href: string) => familyFrames[href.split('/').filter(Boolean).at(-1) || ''] || { ratio: .889, position: 55 };
const explicitBrandLines = home.brand.heading.split(/\n+/).map(line => line.trim()).filter(Boolean);
const brandWords = home.brand.heading.split(/\s+/);
const brandBreak = brandWords.reduce((best, _word, index) => {
  if (index === 0 || index === brandWords.length || /^(à|au|aux|de|du|des|en|et|pour|le|la|les|un|une)$/i.test(brandWords[index - 1])) return best;
  const midpoint = home.brand.heading.length / 2;
  return Math.abs(brandWords.slice(0, index).join(' ').length - midpoint) < Math.abs(brandWords.slice(0, best).join(' ').length - midpoint) ? index : best;
}, 1);
const brandLines = explicitBrandLines.length > 1 ? explicitBrandLines : [brandWords.slice(0, brandBreak).join(' '), brandWords.slice(brandBreak).join(' ')].filter(Boolean);
---

<svg width="0" height="0" class="svg-symbols" aria-hidden="true">
  <defs>
    <symbol id="fan" viewBox="0 0 200 104">
      <g fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M4 102 A96 96 0 0 1 196 102"/><path d="M26 102 A74 74 0 0 1 174 102"/><path d="M48 102 A52 52 0 0 1 152 102"/><path d="M70 102 A30 30 0 0 1 130 102"/>
        <path d="M100 102 V6"/><path d="M100 102 L32 34"/><path d="M100 102 L168 34"/><path d="M100 102 L10 72"/><path d="M100 102 L190 72"/><path d="M100 102 L63 14"/><path d="M100 102 L137 14"/><path d="M2 102 H198"/>
      </g>
    </symbol>
    <symbol id="step" viewBox="0 0 44 24"><path d="M2 23 H42 M8 23 V15 H14 V9 H20 V3 H24 V9 H30 V15 H36 V23" fill="none" stroke="currentColor" stroke-width="1.6"/></symbol>
    <symbol id="city-map" viewBox="0 0 1440 900">
<rect class="m-land" width="1440" height="900"/>
<path class="m-sea" d="M0 0 H1440 V150 C1300 170 1180 120 1060 170 C930 225 820 250 700 285 C590 318 470 330 380 390 C300 445 190 470 0 520 Z"/>
<path class="m-coast" d="M0 520 C190 470 300 445 380 390 C470 330 590 318 700 285 C820 250 930 225 1060 170 C1180 120 1300 170 1440 150" fill="none" stroke-width="1.5"/>
<g class="m-grid" stroke-width="1" fill="none">
<path d="M0 600 L1440 380"/><path d="M0 690 L1440 470"/><path d="M0 780 L1440 560"/><path d="M60 900 L1440 650"/><path d="M400 900 L1440 740"/>
<path d="M300 900 L520 330"/><path d="M500 900 L700 290"/><path d="M700 900 L860 240"/><path d="M900 900 L1020 185"/><path d="M1100 900 L1180 150"/><path d="M1300 900 L1330 160"/>
</g>
<g class="m-road" stroke-width="2" fill="none">
<path d="M120 900 C260 700 420 560 700 480 S1180 330 1440 300"/>
<path d="M620 900 C640 760 700 600 760 470"/>
<path d="M980 900 C940 720 900 560 860 420"/>
</g>
<path class="m-zone" d="M700 470 L905 440 L820 640 Z" stroke-width="1.5" stroke-dasharray="6 6"/>
<g font-family="Helvetica Neue, Helvetica, Albert Sans, Arial, sans-serif" font-size="14" letter-spacing="3">
<text class="m-sea-lbl" x="760" y="120" font-size="16" letter-spacing="6">OCÉAN ATLANTIQUE</text>
<text class="m-lbl" x="150" y="455">CORNICHE · AÏN DIAB</text>
<text class="m-lbl" x="300" y="610">ANFA</text>
<text class="m-lbl" x="600" y="760">MAÂRIF</text>
<text class="m-lbl" x="1110" y="330">CENTRE-VILLE</text>
<text class="m-lbl" x="1250" y="215">PORT</text>
<text class="m-hi" x="742" y="428" font-size="15" letter-spacing="4">TRIANGLE D'OR</text>
</g>
<g transform="translate(806 530)">
<circle r="16" fill="none" stroke="#DB0812" stroke-width="2" class="pulse"/>
<circle r="7" fill="#DB0812"/>
<g class="m-pin" transform="translate(-22 -66)"><use href="#step" width="44" height="24"/></g>
<line class="m-pin" x1="0" y1="-40" x2="0" y2="-10" stroke-width="1.2"/>
<text class="m-hi" x="22" y="-48" font-family="Helvetica Neue, Helvetica, Albert Sans, Arial, sans-serif" font-size="15" letter-spacing="2">{site.name.toUpperCase()}</text>
</g>
    </symbol>
  </defs>
</svg>
<a class="skip-link" href="#main-content">Aller au contenu</a>
<header class="hd" id="hd">
  <a class="logo" href="/#accueil" data-go="accueil" aria-label={`${site.name}, accueil`}>{site.logoDark ? <img class="lg-w" src={site.logoDark.src} alt={site.logoDark.alt} width="180" height="57"/> : <span class="brand-name lg-w">{site.name}</span>}{site.logoLight ? <img class="lg-r" src={site.logoLight.src} alt={site.logoLight.alt} width="180" height="57"/> : <span class="brand-name lg-r">{site.name}</span>}<span class:list={["loc", {"loc-long": (site.location || '').length > 8}]}>{site.location}</span></a>
  <nav aria-label="Navigation principale">
    <span class="status" id="status"><i aria-hidden="true"></i><span id="clock" data-city={site.location}>{site.location}</span></span>
    <NativeNav items={site.navigation} variant="header" />
  </nav>
  <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation">Menu</button>
  <ThemeToggle />
</header>
<nav id="mobile-navigation" class="mobile-navigation" aria-label="Navigation mobile" hidden>
  <NativeNav items={site.navigation} variant="mobile" />
</nav>

<main id="main-content" class="home">
<div class="desk">
  <section class:list={['scene', {'without-visual': !(home.heroImage)}]} id="accueil" data-scene={(home.heroImage) ? 'hero' : undefined} style="--g: 0; --t: 0; --w: 0;">
    <div class="pin">
      <div class="words"><div>{home.eyebrow && <p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{home.eyebrow}</p>}<h1 {...homeEdit?.title}>{home.title}</h1></div><div class="side">{site.tagline && <p class="kick">{site.tagline}</p>}<span class="hint">{labels.scroll} ↓</span></div></div>
      {home.heroImage && <div class="ph card" {...homeEdit?.hero_image}><img src={home.heroImage.src} alt={home.heroImage.alt} fetchpriority="high" style="object-position: center 55%;"/><div class="veil"></div></div>}
      <div class:list={["over", {onphoto: !!home.heroImage}]}><div>{home.eyebrow && <p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{home.eyebrow}</p>}{home.intro && <h2 {...homeEdit?.intro}>{home.intro}</h2>}<div class="row"><a class="btn solid" href="/catalogue/" {...siteEdit?.catalogue_label}>{labels.download}</a><a class="btn" href="/showroom-casablanca/">{labels.visit}</a></div></div></div>
    </div>
  </section>
  {home.brand.present !== false && <section class:list={['scene', {'without-visual': !(home.brand.image || home.brand.detailImage)}]} id="italie" data-scene={(home.brand.image || home.brand.detailImage) ? 'italie' : undefined} style="--a: 0; --o: 0;">
    <div class="pin">
      <div class="col" {...homeEdit?.sections}><p class="kick fade"><svg aria-hidden="true"><use href="#step"/></svg>{site.name}</p>{home.brand.heading && <h2 class="big" aria-label={home.brand.heading}>{brandLines.map(line => <span><b>{line}</b></span>)}</h2>}{home.brand.text && <p class="txt fade">{home.brand.text}</p>}{hasCta(home.brand) && <div class="row fade"><a class="btn" href={home.brand.ctaHref}>{home.brand.ctaLabel}</a></div>}</div>
      {home.brand.image && <div class="ph p1" {...homeEdit?.[home.brand.imageField || 'brand_image']}><img src={home.brand.image.src} alt={home.brand.image.alt} loading="lazy" style="object-position: center 55%;"/></div>}{home.brand.detailImage && <div class="ph p2" {...homeEdit?.brand_detail_image}><img src={home.brand.detailImage.src} alt={home.brand.detailImage.alt} loading="lazy" style="object-position: center 60%;"/></div>}
      {home.brand.caption && <span class="cap" {...homeEdit?.brand_caption}>{home.brand.caption}</span>}
    </div>
  </section>}
  {home.collections.present !== false && <section class="scene" id="collections" data-scene="collections" style={`--h: 0; --shift: 0; --count: ${families.length};`}>
    <div class="pin"><div class="track">
      <div class="intro" {...homeEdit?.sections}><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.collections}</p>{home.collections.heading && <h2 class="big" {...homeEdit?.sections}>{home.collections.heading}</h2>}{home.collections.text && <p class="txt" {...homeEdit?.sections}>{home.collections.text}</p>}{home.collections.image && <img class="section-image" src={home.collections.image.src} alt={home.collections.image.alt} loading="lazy"/>}{hasCta(home.collections) && <div class="row"><a class="btn" href={home.collections.ctaHref}>{home.collections.ctaLabel}</a></div>}</div>
      {families.map((family, index) => <a class="cc" href={family.href} style={`--i: ${index}; --r: ${familyFrame(family.href).ratio};`}>{family.image && <div class="frame"><img src={family.image.src} alt={family.image.alt} loading="lazy" style={`object-position: center ${familyFrame(family.href).position}%;`}/></div>}<div class="nm"><b {...(family.shortTitle ? family.entry?.edit?.short_title : family.entry?.edit?.title)}>{family.shortTitle || family.title}</b><span>{labels.discover} →</span></div><p {...family.entry?.edit?.card_text}>{family.summary}</p></a>)}
      {hasCta(home.catalogue) && <a class="cc cta" href={home.catalogue.ctaHref} style={`--i: ${families.length};`}><div class="frame"><svg class="deco" viewBox="0 0 200 104" aria-hidden="true"><use href="#fan"/></svg>{home.catalogue.heading && <h3>{home.catalogue.heading}</h3>}<span class="btn solid">{home.catalogue.ctaLabel}</span></div><div class="nm"><b>{labels.catalogue}</b><span>PDF</span></div></a>}
    </div><div class="bar" aria-hidden="true"><i></i></div></div>
  </section>}
  {home.showroom.present !== false && <section class:list={['scene', {'without-visual': !(home.showroom.image)}]} id="showroom" data-scene={(home.showroom.image) ? 'showroom' : undefined} style="--s: 0; --r: 0;">
    <div class="pin">{home.showroom.image && <div class="ph img" {...homeEdit?.[home.showroom.imageField || 'showroom_image']}><img src={home.showroom.image.src} alt={home.showroom.image.alt} loading="lazy" style="object-position: center 62%;"/><div class="veil"></div>{home.showroom.invitation && <div class="say onphoto"><h2 class="big" {...homeEdit?.showroom_invitation}>{home.showroom.invitation}</h2></div>}</div>}
      <div class="info" {...homeEdit?.sections}>{!home.showroom.image && home.showroom.invitation && <p class="txt" {...homeEdit?.showroom_invitation}>{home.showroom.invitation}</p>}<p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.showroom}</p>{home.showroom.heading && <h2 class="big" {...homeEdit?.sections}>{home.showroom.heading}</h2>}{home.showroom.text && <p class="txt" {...homeEdit?.sections}>{home.showroom.text}</p>}{hasContact && <dl class="facts">{site.address && <div><dt>Adresse</dt><dd {...siteEdit?.address}>{site.address}</dd></div>}{site.hours && <div><dt>Horaires</dt><dd {...siteEdit?.hours}>{site.hours}</dd></div>}<Fragment>{site.phone && <div><dt>Téléphone{site.whatsappHref && ' · WhatsApp'}</dt><dd {...siteEdit?.contact_phone}>{site.whatsappHref ? <a href={site.whatsappHref}>{site.phone}</a> : <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a>}</dd></div>}</Fragment>{site.publicEmail && <div><dt>E-mail</dt><dd {...siteEdit?.public_email}><a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a></dd></div>}</dl>}<div class="row">{site.whatsappHref && <a class="btn red" href={site.whatsappHref} target="_blank" rel="noopener noreferrer">{labels.appointment}</a>}{hasCta(home.showroom) && <a class="btn" href={home.showroom.ctaHref}>{home.showroom.ctaLabel}</a>}</div></div>
    </div>
  </section>}
  <section id="plan">
    <svg class="map" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Illustration de Casablanca"><use href="#city-map"/></svg>
    <div class="panel"><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.showroom}</p><h2>{site.name}</h2>{site.address && <p class="txt">{site.address}</p>}{site.hours && <p class="txt">{site.hours}</p>}<div class="row">{site.mapUrl && <a class="btn solid" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Itinéraire</a>}{hasCta(home.showroom) && <a class="btn" href={home.showroom.ctaHref}>{home.showroom.ctaLabel}</a>}</div></div>
    <span class="note">{site.mapNote || 'Plan illustratif de Casablanca.'}</span>
  </section>
  {home.catalogue.present !== false && <section class:list={['scene', {'without-visual': !(catalogueImage)}]} id="catalogue" data-scene={(catalogueImage) ? 'catalogue' : undefined} style="--c: 0; --d: 0;">
    <div class="pin"><svg class="fan deco" viewBox="0 0 200 104" aria-hidden="true"><use href="#fan"/></svg>{catalogueImage && <div class="book" aria-hidden="true"><div class="b"><div class="pg" style="--n: 3;"></div><div class="pg" style="--n: 2;"></div><div class="pg" style="--n: 1;"></div><div class="cv" {...(home.catalogue.image ? homeEdit?.sections : catalogue?.entry?.edit?.cover)}>{catalogueImage && <img class="pic" src={catalogueImage.src} alt="" loading="lazy"/>}<div class="t onphoto">{site.logoDark ? <img class="lg-w keep" src={site.logoDark.src} alt=""/> : <strong>{site.name}</strong>}<span class="loc">{site.location}</span><span>{catalogue?.edition}</span></div></div></div></div>}
      <div class="form" {...homeEdit?.sections}>{catalogue?.title && <p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{catalogue.title}</p>}{home.catalogue.heading && <h2 class="big" {...homeEdit?.sections}>{home.catalogue.heading}</h2>}{home.catalogue.text && <p class="txt" {...homeEdit?.sections}>{home.catalogue.text}</p>}{hasCta(home.catalogue) && <a class="section-link" href={home.catalogue.ctaHref}>{home.catalogue.ctaLabel} <span aria-hidden="true">→</span></a>}{catalogue?.isPlaceholder && site.placeholderNotice && <p class="legal" {...siteEdit?.placeholder_notice}>{site.placeholderNotice}</p>}<CatalogueForm id="home-desktop" /></div>
    </div>
  </section>}
  {home.journal.present !== false && <section id="journal"><div class="top" {...homeEdit?.sections}><div><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.journal}</p>{home.journal.heading && <h2 class="big" {...homeEdit?.sections}>{home.journal.heading}</h2>}</div>{hasCta(home.journal) && <a class="btn" href={home.journal.ctaHref}>{home.journal.ctaLabel}</a>}</div>{home.journal.text && <p class="txt journal-intro">{home.journal.text}</p>}{home.journal.image && <img class="journal-section-image" src={home.journal.image.src} alt={home.journal.image.alt} loading="lazy"/>}
    <div class="jgrid">{featuredPost && <a class="art feat rv" href={featuredPost.href}>{featuredPost.image && <div class="im"><img src={featuredPost.image.src} alt={featuredPost.image.alt} loading="lazy"/></div>}<span class="meta">{featuredPost.category}{featuredPost.readingTime && ` · ${featuredPost.readingTime}`}</span><h3 {...featuredPost.entry?.edit?.title}>{featuredPost.title}</h3><span class="article-link">{labels.readArticle} <span aria-hidden="true">→</span></span></a>}<div class="jside">{otherPosts.map(post => <a class="art sm rv" href={post.href}>{post.image && <div class="im"><img src={post.image.src} alt={post.image.alt} loading="lazy"/></div>}<div class="tx"><span class="meta">{post.category}{post.readingTime && ` · ${post.readingTime}`}</span><h3 {...post.entry?.edit?.title}>{post.title}</h3><span class="article-link">{labels.readArticle} <span aria-hidden="true">→</span></span></div></a>)}</div></div>
  </section>}
</div>

<div class="mob m">
  <section id="m-accueil"><h1 class="big" {...homeEdit?.title}>{home.title}</h1>{home.heroImage && <div class="mimg m-hero-image" {...homeEdit?.hero_image}><img src={home.heroImage.src} alt={home.heroImage.alt} fetchpriority="high" style="object-position: center 55%;"/></div>}{home.eyebrow && <p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{home.eyebrow}</p>}{home.intro && <p class="txt" {...homeEdit?.intro}>{home.intro}</p>}<div class="row"><a class="btn solid" href="/catalogue/" {...siteEdit?.catalogue_label}>{labels.download}</a><a class="btn" href="/showroom-casablanca/">{labels.visit}</a></div></section>
  {home.brand.present !== false && <section id="m-italie"><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{site.name}</p>{home.brand.heading && <h2 class="big" {...homeEdit?.sections}>{brandLines.map((line, index) => <Fragment>{index > 0 && <br/>}{line}</Fragment>)}</h2>}{home.brand.text && <p class="txt" {...homeEdit?.sections}>{home.brand.text}</p>}{home.brand.image && <div class="mimg m-brand-image" {...homeEdit?.[home.brand.imageField || 'brand_image']}><img src={home.brand.image.src} alt={home.brand.image.alt} loading="lazy" style="object-position: center 55%;"/></div>}{home.brand.caption && <p class="legal" {...homeEdit?.brand_caption}>{home.brand.caption}</p>}{hasCta(home.brand) && <div class="row"><a class="btn" href={home.brand.ctaHref}>{home.brand.ctaLabel}</a></div>}</section>}
  {home.collections.present !== false && <section id="m-collections"><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.collections}</p>{home.collections.heading && <h2 class="big" {...homeEdit?.sections}>{home.collections.heading}</h2>}{home.collections.text && <p class="txt" {...homeEdit?.sections}>{home.collections.text}</p>}{home.collections.image && <div class="mimg m-section-image"><img src={home.collections.image.src} alt={home.collections.image.alt} loading="lazy"/></div>}{hasCta(home.collections) && <div class="row"><a class="btn" href={home.collections.ctaHref}>{home.collections.ctaLabel}</a></div>}<div class="hscroll" tabindex="0" aria-label={labels.collections}>{families.map(family => <a href={family.href}>{family.image && <div class="mimg m-family-image"><img src={family.image.src} alt={family.image.alt} loading="lazy" style={`object-position: center ${familyFrame(family.href).position}%;`}/></div>}<b class="m-family-title">{family.shortTitle || family.title}</b><span class="txt m-family-summary">{family.summary}</span></a>)}</div></section>}
  {home.showroom.present !== false && <section id="m-showroom"><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.showroom}</p>{home.showroom.heading && <h2 class="big" {...homeEdit?.sections}>{home.showroom.heading}</h2>}{home.showroom.image && <div class="mimg m-showroom-image" {...homeEdit?.[home.showroom.imageField || 'showroom_image']}><img src={home.showroom.image.src} alt={home.showroom.image.alt} loading="lazy" style="object-position: center 62%;"/></div>}{home.showroom.invitation && <p class="txt" {...homeEdit?.showroom_invitation}>{home.showroom.invitation}</p>}{home.showroom.text && <p class="txt" {...homeEdit?.sections}>{home.showroom.text}</p>}{hasContact && <dl class="facts">{site.address && <div><dt>Adresse</dt><dd {...siteEdit?.address}>{site.address}</dd></div>}{site.hours && <div><dt>Horaires</dt><dd {...siteEdit?.hours}>{site.hours}</dd></div>}<Fragment>{site.phone && <div><dt>Téléphone{site.whatsappHref && ' · WhatsApp'}</dt><dd {...siteEdit?.contact_phone}>{site.whatsappHref ? <a href={site.whatsappHref}>{site.phone}</a> : <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a>}</dd></div>}</Fragment>{site.publicEmail && <div><dt>E-mail</dt><dd {...siteEdit?.public_email}><a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a></dd></div>}</dl>}<div class="row">{site.whatsappHref && <a class="btn red" href={site.whatsappHref} target="_blank" rel="noopener noreferrer">{labels.appointment}</a>}{hasCta(home.showroom) && <a class="btn" href={home.showroom.ctaHref}>{home.showroom.ctaLabel}</a>}</div></section>}
  <section id="m-plan"><svg class="map" preserveAspectRatio="xMidYMid meet" viewBox="0 0 1440 900" role="img" aria-label="Illustration de Casablanca"><use href="#city-map"/></svg><p class="legal">{site.mapNote || 'Plan illustratif de Casablanca.'}</p>{site.mapUrl && <a class="btn solid" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Itinéraire</a>}</section>
  {home.catalogue.present !== false && <section id="m-catalogue">{home.catalogue.image && <div class="mimg m-section-image"><img src={home.catalogue.image.src} alt={home.catalogue.image.alt} loading="lazy"/></div>}{catalogue?.title && <p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{catalogue.title}</p>}{home.catalogue.heading && <h2 class="big" {...homeEdit?.sections}>{home.catalogue.heading}</h2>}{home.catalogue.text && <p class="txt" {...homeEdit?.sections}>{home.catalogue.text}</p>}{hasCta(home.catalogue) && <a class="section-link" href={home.catalogue.ctaHref}>{home.catalogue.ctaLabel} <span aria-hidden="true">→</span></a>}{catalogue?.isPlaceholder && site.placeholderNotice && <p class="legal" {...siteEdit?.placeholder_notice}>{site.placeholderNotice}</p>}<CatalogueForm id="home-mobile" /></section>}
  {home.journal.present !== false && <section id="m-journal"><p class="kick"><svg aria-hidden="true"><use href="#step"/></svg>{labels.journal}</p>{home.journal.heading && <h2 class="big" {...homeEdit?.sections}>{home.journal.heading}</h2>}{home.journal.text && <p class="txt" {...homeEdit?.sections}>{home.journal.text}</p>}{home.journal.image && <div class="mimg m-section-image"><img src={home.journal.image.src} alt={home.journal.image.alt} loading="lazy"/></div>}{posts.slice(0, 5).map(post => <a class="jart" href={post.href}>{post.image && <div class="mimg m-journal-image"><img src={post.image.src} alt={post.image.alt} loading="lazy"/></div>}<span class="kick">{post.category}{post.readingTime && ` · ${post.readingTime}`}</span><h3 {...post.entry?.edit?.title}>{post.title}</h3><span class="article-link">{labels.readArticle} <span aria-hidden="true">→</span></span></a>)}{hasCta(home.journal) && <a class="btn" href={home.journal.ctaHref}>{home.journal.ctaLabel}</a>}</section>}
</div>
{home.body && home.body.length > 0 && <section class="home-editorial"><div class="home-prose" {...homeEdit?.content}><PortableText value={home.body}/></div></section>}
{extraSections.map(section => <section class="home-editorial" {...homeEdit?.sections}><div class="home-prose">{(section.displayHeading || section.heading) && <h2 class="big">{section.displayHeading || section.heading}</h2>}{section.text && <p class="txt">{section.text}</p>}{section.image && <img class="editorial-image" src={section.image.src} alt={section.image.alt} loading="lazy"/>}{hasCta(section) && <a class="btn" href={section.ctaHref}>{section.ctaLabel}</a>}</div></section>)}
</main>
<footer class="ft">
  <svg class="fan deco" viewBox="0 0 200 104" aria-hidden="true"><use href="#fan"/></svg><div class="brand">{site.logoDark ? <img class="lg-w" src={site.logoDark.src} alt={site.logoDark.alt} width="180" height="57"/> : <span class="brand-name lg-w">{site.name}</span>}{site.logoLight ? <img class="lg-r" src={site.logoLight.src} alt={site.logoLight.alt} width="180" height="57"/> : <span class="brand-name lg-r">{site.name}</span>}<span class="loc">{site.location}</span>{site.tagline && <p>{site.tagline}</p>}</div>
  <div><h4>{labels.showroom}</h4><ul>{site.address && <li>{site.address}</li>}{site.hours && <li>{site.hours}</li>}{site.phone && <li>{site.whatsappHref ? <a href={site.whatsappHref}>{site.phone} · WhatsApp</a> : <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a>}</li>}{site.publicEmail && <li><a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a></li>}<li><a href="/showroom-casablanca/">{labels.visit}</a></li></ul></div>
  <div><h4>Explorer</h4><ul>{site.navigation.map(item => <li><NativeNav items={[item]} variant="footer" /></li>)}<li><a href="/confidentialite/">Confidentialité</a></li></ul></div>
  <div class="base"><span>{site.name}</span>{site.footerNote && <span {...siteEdit?.footer_text}>{site.footerNote}</span>}{site.previewNotice && <p class="preview-notice" {...siteEdit?.preview_notice}>{site.previewNotice}</p>}</div>
</footer>
<script>
  import '../scripts/site';
  import '../scripts/home';
</script>
