---
import {EmDashHead} from 'emdash/ui';
import {getContentSeo} from 'emdash';
import {createPublicPageContext} from 'emdash/page';
import {env} from 'cloudflare:workers';
import PreviewViewport from './PreviewViewport.astro';
import { editorPreviewContentPolicy } from '../lib/editor-preview';
import { fallbackFavicon, pageBreadcrumbs, socialImage } from '../lib/structured-data';
import { rememberRenderedSeo } from '../lib/seo-render-context';
import type { BreadcrumbItem } from 'emdash';
interface Props {title:string;description?:string;site:any;image?:any;entry?:any;collection?:string;article?:boolean;breadcrumbs?:BreadcrumbItem[];}
const {title,description,site,image,entry,article=false}=Astro.props;
// EmDashHead applies the native SEO panel to metadata, but <title> belongs to
// the template. Keep both surfaces aligned without changing the visible H1.
const resolvedTitle=(entry && getContentSeo(entry)?.title) || title;
const isoDate=(value:unknown)=>{
  if(!(value instanceof Date)&&typeof value!=='string')return undefined;
  const date=new Date(value);return Number.isNaN(date.getTime())?undefined:date.toISOString();
};
const collection=Astro.props.collection || entry?._collection;
const indexable=(env as Record<string,unknown>).SITE_INDEXABLE==='true';
const origin=site.settings?.url || Astro.url.origin;
const headline=entry?.data?.title || title;
const resolvedImage=socialImage(image,site,Astro.url.pathname,origin,{collection,slug:entry?.data?.slug});
const favicon=fallbackFavicon(site,origin);
const breadcrumbs=pageBreadcrumbs({path:Astro.url.pathname,title:headline,site,supplied:Astro.props.breadcrumbs});
const isPreview=Astro.url.searchParams.has('_preview') || Astro.url.pathname.startsWith('/preview/');
if (import.meta.env.DEV && ['GET', 'HEAD'].includes(Astro.request.method)) {
  const previewPolicy = editorPreviewContentPolicy({
    development: true,
    editorOrigin: import.meta.env.CATTELAN_EDITOR_ORIGIN,
    cmsPreview: isPreview,
  });
  // This component is used only by the public frontend. EmDash keeps its own
  // admin/auth/API headers; signed CMS previews keep their existing policy too.
  if (previewPolicy && !Astro.response.headers.has('Content-Security-Policy')) {
    Astro.response.headers.set('Content-Security-Policy', previewPolicy);
  }
}
Astro.response.headers.set('Cache-Control',isPreview?'private, no-store':'no-store');
if(!indexable || isPreview) Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
const page=createPublicPageContext({Astro,kind:entry?'content':'custom',pageType:article?'article':'website',title:resolvedTitle,pageTitle:headline,description,image:resolvedImage,canonical:new URL(Astro.url.pathname,origin).href,siteName:site.name,siteUrl:origin,breadcrumbs,seo:{ogTitle:resolvedTitle,robots:!indexable||isPreview?'noindex, nofollow':'index, follow'},content:entry&&collection?{collection,id:String(entry.data.id || entry.id),slug:entry.data.slug || entry.id}:undefined,articleMeta:article?{publishedTime:isoDate(entry?.data.publishedAt || entry?.data.published_at),modifiedTime:isoDate(entry?.data.updatedAt || entry?.data.updated_at),author:entry?.data.byline?.displayName}:undefined});
rememberRenderedSeo(page, site, entry?.data);
---
<title>{resolvedTitle}</title>
<EmDashHead page={page}/>
{favicon && <link rel="icon" href={favicon}/>}
{site.analyticsToken && !isPreview && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({token: site.analyticsToken})}></script>}
<PreviewViewport />
<meta name="color-scheme" content="dark light"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@200;300;400;500&display=swap" rel="stylesheet"/>
<script is:inline>
  try { const mode=localStorage.getItem('ci-mode')==='light'?'light':'dark';document.documentElement.dataset.mode=mode;document.documentElement.classList.add(mode); } catch {document.documentElement.dataset.mode='dark';}
</script>
