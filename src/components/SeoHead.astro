---
import {EmDashHead} from 'emdash/ui';
import {createPublicPageContext} from 'emdash/page';
import {env} from 'cloudflare:workers';
interface Props {title:string;description?:string;site:any;image?:any;entry?:any;collection?:string;article?:boolean;}
const {title,description,site,image,entry,article=false}=Astro.props;
const isoDate=(value:unknown)=>{
  if(!(value instanceof Date)&&typeof value!=='string')return undefined;
  const date=new Date(value);return Number.isNaN(date.getTime())?undefined:date.toISOString();
};
const collection=Astro.props.collection || entry?._collection;
const indexable=(env as Record<string,unknown>).SITE_INDEXABLE==='true';
const origin=site.settings?.url || Astro.url.origin;
const isPreview=Astro.url.searchParams.has('_preview') || Astro.url.pathname.startsWith('/preview/');
Astro.response.headers.set('Cache-Control','no-store');
if(!indexable || isPreview) Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
const page=createPublicPageContext({Astro,kind:entry?'content':'custom',pageType:article?'article':'website',title,pageTitle:title,description,image:typeof image==='string'?image:image?.src,canonical:new URL(Astro.url.pathname,origin).href,siteName:site.name,siteUrl:origin,seo:{robots:!indexable||isPreview?'noindex, nofollow':'index, follow'},content:entry&&collection?{collection,id:String(entry.data.id || entry.id),slug:entry.data.slug || entry.id}:undefined,articleMeta:article?{publishedTime:isoDate(entry?.data.publishedAt || entry?.data.published_at),modifiedTime:isoDate(entry?.data.updatedAt || entry?.data.updated_at),author:entry?.data.byline?.displayName}:undefined});
---
<EmDashHead page={page}/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="color-scheme" content="dark light"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@200;300;400;500&display=swap" rel="stylesheet"/>
<script is:inline>
  try { const mode=localStorage.getItem('ci-mode')==='light'?'light':'dark';document.documentElement.dataset.mode=mode;document.documentElement.classList.add(mode); } catch {document.documentElement.dataset.mode='dark';}
</script>
