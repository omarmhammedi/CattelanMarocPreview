---
import { actions, type ActionKey } from '../lib/actions';
interface Props {
  order: ActionKey[];
  advisorHref?: string | null;
  advisorLabel?: string;
  model?: string;
}
const { order, advisorHref, advisorLabel = actions.advisor.label, model } = Astro.props;
// The booking form records the model the visitor came from.
const appointmentHref = model ? actions.appointment.href.replace('#', `?modele=${encodeURIComponent(model)}#`) : actions.appointment.href;
type Link = { key: ActionKey; label: string; href: string; external: boolean };
const links = order.flatMap((key): Link[] => key === 'advisor'
  ? advisorHref ? [{ key, label: advisorLabel, href: advisorHref, external: true }] : []
  : [{ key, label: actions[key].label, href: key === 'appointment' ? appointmentHref : actions[key].href, external: false }]);
// The first action carries the weight; later ones step down to an outline, then a text link.
const styles = ['btn solid', 'btn', 'text-link'];
---
{links.length > 0 && <div class="row site-actions">
  {links.map((link, index) => <a class={styles[index]} href={link.href} data-action={link.key} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}{link.external && <span aria-hidden="true">↗</span>}</a>)}
</div>}
