---
import { actionsFor, type ActionKey } from '../lib/actions';
import WhatsappIcon from './WhatsappIcon.astro';
interface Props {
  order: ActionKey[];
  advisorHref?: string | null;
  advisorLabel?: string;
  /** Accessible name of the WhatsApp link; the visible label leaves the channel to the icon. */
  advisorName?: string;
  model?: string;
  site?: any;
}
const actions=actionsFor(Astro.props.site);
const { order, advisorHref, advisorLabel = actions.advisor.label, advisorName = `${advisorLabel} sur ${actions.advisor.channel}`, model } = Astro.props;
// The booking form records the model the visitor came from.
const appointmentHref = model ? actions.appointment.href.replace('#', `?modele=${encodeURIComponent(model)}#`) : actions.appointment.href;
type Link = { key: ActionKey; label: string; href: string; external: boolean };
const links = order.flatMap((key): Link[] => key === 'advisor'
  ? advisorHref ? [{ key, label: advisorLabel, href: advisorHref, external: true }] : []
  : [{ key, label: actions[key].label, href: key === 'appointment' ? appointmentHref : actions[key].href, external: false }]);
// The first action carries the weight; later ones step down to an outline, then a text link.
const styles = ['btn solid', 'btn', 'text-link'];
---
{links.length > 0 && <div class="row site-actions">
  {links.map((link, index) => <a class={styles[index]} href={link.href} data-action={link.key} aria-label={link.key === 'advisor' ? advisorName : undefined} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.key === 'advisor' && <WhatsappIcon />}{link.label}{link.external && <span aria-hidden="true">↗</span>}</a>)}
</div>}
