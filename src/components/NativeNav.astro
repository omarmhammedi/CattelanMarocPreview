---
export interface NavigationItem { label: string; url?: string; target?: string | null; children?: NavigationItem[] }
interface Props { items: NavigationItem[] }
const {items}=Astro.props;
---
{items.map(item => item.children?.length ? <details class="native-nav-group">
  <summary>{item.label}</summary>
  <div class="native-nav-children">{item.url && <a href={item.url} target={item.target} rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}>{item.label}</a>}<Astro.self items={item.children} /></div>
</details> : item.url ? <a href={item.url} target={item.target} rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}>{item.label}</a> : <span>{item.label}</span>)}
