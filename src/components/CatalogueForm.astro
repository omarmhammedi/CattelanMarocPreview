---
import { privacyNotice } from '../lib/privacy';
import { getSite, getCatalogue } from '../lib/content';
import { CITIES } from '../plugins/catalogue/core';
interface Props {
  id: string; catalogueId?: string; labels?: Record<string, string>; compact?: boolean;
  site?: {form: Record<string, string>; labels: {contact?: string}; publicEmail?: string; cndpReceipt?: string};
  catalogue?: {id: string; downloadLabel: string} | null;
}
const { id, compact = false } = Astro.props;
// Parent pages already resolved the published or signed-preview context.
// Explicit null means no active catalogue; only absent props trigger a read.
const [site, catalogue] = await Promise.all([
  Astro.props.site ?? getSite(),
  Astro.props.catalogue === undefined ? getCatalogue() : Astro.props.catalogue,
]);
const labels = { ...site.form, ...Astro.props.labels };
const catalogueId = Astro.props.catalogueId || catalogue?.id;
const contactLabel = site.labels.contact || 'Coordonnées du showroom';
---
{catalogueId ? <form method="post" action="/_emdash/api/plugins/catalogue-leads/request" class:list={['catalogue-form', { compact }]} data-catalogue-form data-catalogue-id={catalogueId} data-error={labels.error} data-name-error={labels.nameError} data-email-error={labels.emailError} data-unavailable={labels.unavailable} data-pending={labels.pending} data-success-title={labels.successTitle} data-success-text={labels.successText} data-download-label={catalogue?.downloadLabel} data-contact-label={contactLabel}>
  <noscript><p>Activez JavaScript pour télécharger le catalogue, ou <a href="/showroom-casablanca/#showroom-contact">contactez le showroom</a>.</p><style>.catalogue-form button[type=submit]{display:none}</style></noscript>
  <div class="catalogue-fields">
    <div><label for={`${id}-name`}>{labels.name}</label><input id={`${id}-name`} name="name" autocomplete="name" required minlength="2" maxlength="120" aria-describedby={`${id}-name-error`} /><span class="field-error" id={`${id}-name-error`} data-field-error="name" hidden></span></div>
    <div><label for={`${id}-whatsapp`}>Numéro WhatsApp (facultatif)</label><input id={`${id}-whatsapp`} name="whatsapp" type="tel" inputmode="tel" autocomplete="tel" maxlength="30" placeholder="Avec l’indicatif du pays" aria-describedby={`${id}-whatsapp-error`} /><span class="field-error" id={`${id}-whatsapp-error`} data-field-error="whatsapp" hidden></span></div>
    <div><label for={`${id}-email`}>{labels.email}</label><input id={`${id}-email`} name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby={`${id}-email-error`} /><span class="field-error" id={`${id}-email-error`} data-field-error="email" hidden></span></div>
    <div><label for={`${id}-city`}>Ville (facultatif)</label><select id={`${id}-city`} name="city" aria-describedby={`${id}-city-error`}><option value="">Choisir une ville</option>{CITIES.map(city => <option>{city}</option>)}</select><span class="field-error" id={`${id}-city-error`} data-field-error="city" hidden></span></div>
  </div>
  <div class="form-trap" aria-hidden="true"><label for={`${id}-website`}>Site web</label><input id={`${id}-website`} name="website" tabindex="-1" autocomplete="off" /></div>
  <label class="form-consent"><input type="checkbox" name="communicationsConsent" value="yes" /><span>{labels.consent}</span></label>
  <p class="form-note">{import.meta.env.CATTELAN_EMAIL_ENABLED ? 'Après l’envoi du formulaire, vous pourrez télécharger le catalogue. Vous le recevrez aussi par e-mail.' : labels.note}</p>
  {!import.meta.env.CATTELAN_EMAIL_ENABLED && labels.privacy && <p class="form-privacy">{labels.privacy}</p>}
  <p class="form-legal">{privacyNotice('catalogue', site.publicEmail || 'contact@cattelanitalia.ma', site.cndpReceipt)} <a href="/confidentialite/">Confidentialité</a></p>
  <button class="btn solid" type="submit">{labels.submit} <span aria-hidden="true">↗</span></button>
  <div class="form-message" role="status" aria-live="polite" tabindex="-1"></div>
</form> : <div class="catalogue-unavailable" role="status"><p>{labels.unavailable}</p><a class="text-link" href="/showroom-casablanca/#showroom-contact">{contactLabel}</a></div>}
<script>
  import {catalogueFailureMessage} from '../lib/catalogue-messages';
  document.querySelectorAll<HTMLFormElement>('[data-catalogue-form]').forEach(form => {
    let requestId = crypto.randomUUID();
    let fingerprint = '';
    form.noValidate = true;
    const nameInput = form.elements.namedItem('name') as HTMLInputElement;
    const emailInput = form.elements.namedItem('email') as HTMLInputElement;
    const whatsappInput = form.elements.namedItem('whatsapp') as HTMLInputElement;
    const cityInput = form.elements.namedItem('city') as unknown as HTMLInputElement;
    const setFieldError = (field: HTMLInputElement, text: string) => {
      const error = form.querySelector<HTMLElement>(`[data-field-error="${field.name}"]`)!;
      error.textContent = text;
      error.hidden = !text;
      field.setAttribute('aria-invalid', String(Boolean(text)));
    };
    [nameInput, emailInput, whatsappInput, cityInput].forEach(field => field.addEventListener('input', () => setFieldError(field, '')));
    form.addEventListener('submit', async event => {
      event.preventDefault();
      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const invalidName = name.length < 2 || name.length > 120 || /[\u0000-\u001f\u007f]/u.test(name);
      const invalidEmail = email.length > 254 || /[\u0000-\u001f\u007f]/u.test(email) || !/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/u.test(email);
      setFieldError(nameInput, invalidName ? (form.dataset.nameError || 'Indiquez votre nom.') : '');
      setFieldError(emailInput, invalidEmail ? (form.dataset.emailError || 'Vérifiez votre adresse e-mail.') : '');
      const whatsapp = whatsappInput.value.trim();
      const digits = whatsapp.replace(/\D/gu, '').length;
      const invalidWhatsapp = !!whatsapp && (!/^\+?[\d\s().-]+$/u.test(whatsapp) || digits < 8 || digits > 15);
      const invalidCity = false;
      setFieldError(whatsappInput, invalidWhatsapp ? 'Indiquez un numéro WhatsApp valide.' : '');
      setFieldError(cityInput, invalidCity ? 'Choisissez votre ville.' : '');
      const firstInvalid = [[invalidName, nameInput], [invalidWhatsapp, whatsappInput], [invalidEmail, emailInput], [invalidCity, cityInput]].find(([invalid]) => invalid);
      if (firstInvalid) { (firstInvalid[1] as HTMLElement).focus(); return; }
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      if (button.disabled) return;
      const message = form.querySelector<HTMLElement>('.form-message')!;
      const showFailure = (text: string) => {
        const description = document.createElement('p'); description.textContent = text;
        const contact = document.createElement('a');
        contact.className = 'text-link'; contact.href = '/showroom-casablanca/#showroom-contact';
        contact.textContent = form.dataset.contactLabel || 'Coordonnées du showroom';
        message.replaceChildren(description, contact);
        message.focus();
      };
      const data = new FormData(form);
      const payload = { name, email, whatsapp, city: cityInput.value, communicationsConsent: data.get('communicationsConsent') === 'yes', website: String(data.get('website') || ''), catalogueId: form.dataset.catalogueId, sourcePath: location.pathname };
      const nextFingerprint = JSON.stringify(payload);
      if (fingerprint && fingerprint !== nextFingerprint) requestId = crypto.randomUUID();
      fingerprint = nextFingerprint;
      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      message.textContent = form.dataset.pending || '';
      try {
        const response = await fetch('/_emdash/api/plugins/catalogue-leads/request', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-EmDash-Request': '1' }, body: JSON.stringify({ ...payload, requestId }) });
        const envelope = await response.json() as { success?: boolean; data?: { ok?: boolean; downloadUrl?: string; code?: string; message?: string; emailStatus?: string } };
        const result = envelope.data;
        if (!response.ok || !envelope.success) throw new Error('request_failed');
        if (!result?.ok || !result.downloadUrl) {
          const fields: Record<string, [HTMLInputElement, string | undefined]> = { INVALID_NAME: [nameInput, form.dataset.nameError], INVALID_EMAIL: [emailInput, form.dataset.emailError], INVALID_WHATSAPP: [whatsappInput, undefined], INVALID_CITY: [cityInput, undefined] };
          if (result?.code && fields[result.code]) {
            const [field, label] = fields[result.code];
            setFieldError(field, label || result.message || form.dataset.error || '');
            message.textContent = '';
            field.focus();
          } else showFailure(catalogueFailureMessage(result, {unavailable: form.dataset.unavailable, error: form.dataset.error}));
          return;
        }
        message.replaceChildren();
        const title = document.createElement('strong'); title.textContent = form.dataset.successTitle || '';
        const text = document.createElement('p'); text.textContent = form.dataset.successText || '';
        const link = document.createElement('a'); link.className = 'btn'; link.href = result.downloadUrl; link.textContent = form.dataset.downloadLabel || ''; link.setAttribute('download', '');
        message.appendChild(title);
        message.appendChild(text);
        message.appendChild(link);
        if (result.emailStatus) {
          const emailNote = document.createElement('p');
          emailNote.textContent = result.emailStatus === 'sent'
            ? 'Un e-mail contenant le catalogue vous a été envoyé. Son lien est valable 24 heures.'
            : result.emailStatus === 'failed' ? 'L’e-mail n’a pas pu être envoyé. Vous pouvez télécharger le PDF ci-dessus.'
            : 'L’envoi du catalogue par e-mail est en cours. Vous pouvez déjà télécharger le PDF ci-dessus.';
          message.appendChild(emailNote);
        }
        message.focus();
      } catch { showFailure(form.dataset.error || ''); }
      finally { button.disabled = false; form.removeAttribute('aria-busy'); }
    });
  });
</script>
<style>
.catalogue-form{width:100%;margin-top:0}
.catalogue-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:calc(var(--u)*2)}
.catalogue-fields label{display:block;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-bottom:6px}
.catalogue-fields :is(input,select){height:48px;border:0;border-bottom:1px solid rgba(var(--ink-rgb),.35);border-radius:0;background:transparent;color:var(--ink);font-size:max(16px,calc(var(--u)*1.3));font-weight:300;min-width:0;width:100%;padding:0}
.catalogue-fields :is(input,select):focus{outline:none;border-bottom-color:var(--ink)}
.catalogue-fields [aria-invalid="true"]{border-bottom-color:var(--ink);border-bottom-width:2px}
.catalogue-fields select option{color:#0E2028}
.field-error{display:block;margin-top:8px;font-size:12px;line-height:1.5;color:var(--ink)}
.field-error[hidden]{display:none}
.form-consent{display:flex;align-items:flex-start;gap:10px;font-size:12px;line-height:1.6;color:var(--muted);margin:22px 0 10px;cursor:pointer}
.form-consent input{width:16px;height:16px;margin:2px 0 0;flex:none;accent-color:var(--ink)}
.form-note,.form-privacy,.form-legal{font-size:12px;line-height:1.6;color:var(--faint);margin:8px 0;max-width:44em}
.form-privacy a{text-decoration:underline;text-underline-offset:3px}
.catalogue-form button{margin-top:18px;gap:20px}
.catalogue-form button:disabled{opacity:.5;cursor:wait}
.form-message{font-size:15px;font-weight:300;line-height:1.7}
.form-message:not(:empty){margin-top:20px}
.form-message p{margin:8px 0}
.form-trap{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
@media(max-width:700px){
  .catalogue-fields{grid-template-columns:1fr;gap:18px}
  .catalogue-form .btn{max-width:100%;height:auto;min-height:46px;padding-block:14px;white-space:normal;overflow-wrap:anywhere;line-height:1.5;text-align:center}
  .catalogue-form .btn > span{flex:none}
}
</style>
