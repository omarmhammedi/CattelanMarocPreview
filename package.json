{
  "name": "cattelan-maroc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:autostop": "node --test .devcontainer/task-autostop*.test.mjs",
    "deploy": "npm run deploy:client",
    "deploy:client": "CLOUDFLARE_ENV=cattelan-client RAYON_NUM_THREADS=1 NODE_OPTIONS=--max-old-space-size=2048 astro build && node scripts/check-cloudflare-target.mjs --env cattelan-client && wrangler deploy --config dist/server/wrangler.json",
    "deploy:cattelan": "CLOUDFLARE_ENV=cattelan RAYON_NUM_THREADS=1 NODE_OPTIONS=--max-old-space-size=1024 astro build && node scripts/check-cloudflare-target.mjs && wrangler deploy --config dist/server/wrangler.json",
    "setup": "node scripts/setup-dev.mjs",
    "seed:validate": "node scripts/seed-validate.mjs",
    "test:cms": "node tests/cms-sync.mjs",
    "test:catalogue-http": "node tests/catalogue-http.mjs",
    "test:models": "node tests/models-browser.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/react": "7.0.0",
    "@emdash-cms/cloudflare": "0.41.0",
    "astro": "7.3.5",
    "emdash": "0.41.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260930.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "wrangler": "4.145.0",
    "ws": "8.21.0"
  }
}
