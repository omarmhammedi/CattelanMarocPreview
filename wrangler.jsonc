{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cattelan-maroc-preview",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "cattelan-maroc-preview" }],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "cattelan-maroc-media-preview" },
    { "binding": "CATALOGUES", "bucket_name": "cattelan-maroc-catalogues-preview" }
  ],
  "vars": {
    "SITE_INDEXABLE": "false",
    "EMDASH_PREVIEW_PATH_PATTERN": "/preview/{collection}/{id}/"
  },
  "triggers": { "crons": ["* * * * *"] },
  "env": {
    "cattelan": {
      "account_id": "8b8bdf3e76e55a18b03f4043effaf7c8",
      "name": "cattelan-maroc-preview",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cattelan-maroc-preview",
          "database_id": "ca2a675f-d0c6-4f12-b356-423c0018ad80"
        }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "cattelan-maroc-media-preview" },
        { "binding": "CATALOGUES", "bucket_name": "cattelan-maroc-catalogues-preview" }
      ],
      "kv_namespaces": [
        { "binding": "SESSION", "id": "c5b29de1d2384476a027c6a22272bf48" }
      ],
      "vars": {
        "SITE_INDEXABLE": "false",
        "EMDASH_PREVIEW_PATH_PATTERN": "/preview/{collection}/{id}/",
        "EMDASH_SITE_URL": "https://cattelan-maroc-preview.omar-8b8.workers.dev"
      },
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": false },
        "traces": { "enabled": true, "head_sampling_rate": 0 }
      }
    }
  }
}
